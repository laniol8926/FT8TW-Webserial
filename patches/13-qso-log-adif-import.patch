+    if (name === 'EOR' || name === 'EOH') continue;
+    const len = match[2] !== undefined ? Number(match[2]) : null;
+    const start = match.index + match[0].length;
+    fields[name] = len === null ? '' : record.slice(start, start + len);
+  }
+  return fields;
