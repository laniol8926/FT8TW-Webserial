<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title data-i18n="page.title">FT8TW 網頁接收站</title>
  <!-- 多語系（2026-10-07 code review）：HTML 原文是繁中，英文使用者在主程式套用翻譯前會先閃一下中文。
       規則同 i18n/core.mjs detectLocale／resolveLocale：不是繁中就先藏起畫面，applyDom() 後顯示；3 秒保險（主程式沒載入也不會一直空白） -->
  <script>
    (function () {
      var zh = false;
      try {
        var cfg = JSON.parse(localStorage.getItem('ft8tw.config') || 'null') || {};
        // 佈景主題先套上（開場動畫跟著深淺色；之後 config/ui.mjs 會再套一次，規則相同）
        if (cfg.theme === 'dark' || cfg.theme === 'light') document.documentElement.dataset.theme = cfg.theme;
        var pref = cfg.language;
        if (pref === 'zh-TW') zh = true;
        else if (pref !== 'en') {
          var langs = navigator.languages || [navigator.language];
          for (var i = 0; i < langs.length; i++) {
            var l = String(langs[i]).toLowerCase();
            if (l === 'zh' || l.indexOf('zh-') === 0) { zh = true; break; }
            if (l === 'en' || l.indexOf('en-') === 0) break;
          }
        }
      } catch (e) { /* localStorage 不可用：照瀏覽器語系 */ }
      if (zh) return;
      document.documentElement.classList.add('i18n-pending', 'splash-en');
      setTimeout(function () { document.documentElement.classList.remove('i18n-pending'); }, 3000);
    })();
  </script>
  <!-- 開場動畫（使用者 2026-10-09）：主程式初始化完成後由 js/splash.mjs 補滿能量條、淡出並移除；樣式放這裡，CSS 檔還沒到也能先顯示 -->
  <style>
    #splash { --sp-bg: #f6f7f9; --sp-text: #1f2328; --sp-track: #dde3ea;
      position: fixed; inset: 0; z-index: 2147483000; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
      background: var(--sp-bg); color: var(--sp-text); font-family: system-ui, -apple-system, "Segoe UI", "Microsoft JhengHei", sans-serif;
      visibility: visible; transition: opacity 400ms ease; }
    @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) #splash { --sp-bg: #11151b; --sp-text: #e4e8ee; --sp-track: #2c3542; } }
    :root[data-theme="dark"] #splash { --sp-bg: #11151b; --sp-text: #e4e8ee; --sp-track: #2c3542; }
    #splash img { width: 112px; height: 112px; border-radius: 24px; animation: sp-float 1.6s ease-in-out infinite alternate; }
    #splash .sp-bar { width: min(240px, 60vw); height: 8px; border-radius: 4px; background: var(--sp-track); overflow: hidden; }
    #splash .sp-fill { height: 100%; width: 0; border-radius: 4px; background: linear-gradient(90deg, #f0883e, #ffb347 45%, #22d3ee);
      animation: sp-charge 3s cubic-bezier(.2,.7,.3,1) forwards; }
    #splash[data-state="full"] .sp-fill, #splash[data-state="fade"] .sp-fill { animation: none; width: 100%; transition: width 250ms ease-out; }
    #splash[data-state="fade"] { opacity: 0; pointer-events: none; }
    #splash p { margin: 0; font-size: 15px; letter-spacing: 0.04em; }
    .no-splash #splash, #splash .sp-en, .splash-en #splash .sp-zh { display: none; }
    .splash-en #splash .sp-en { display: inline; }
    @keyframes sp-float { from { transform: translateY(0); filter: drop-shadow(0 4px 10px rgb(240 136 62 / 0.25)); }
      to { transform: translateY(-8px); filter: drop-shadow(0 10px 18px rgb(34 211 238 / 0.35)); } }
    @keyframes sp-charge { from { width: 0; } to { width: 88%; } }
    @media (prefers-reduced-motion: reduce) { #splash img { animation: none; } #splash .sp-fill { animation: none; width: 60%; } }
  </style>
  <script>
    if (window.__ft8twSkipSplash) document.documentElement.classList.add('no-splash'); // 自動化檢查（tools/cdp.mjs）不顯示
    setTimeout(function () { var s = document.getElementById('splash'); if (s) s.remove(); }, 15000); // 保險：主程式沒載入也不會一直蓋著
  </script>
  <!-- FT8TW Logo（使用者 2026-10-09；來源見 web/data/SOURCE.md） -->
  <link rel="icon" type="image/png" sizes="32x32" href="assets/logo/ft8tw-logo-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="assets/logo/ft8tw-logo-192.png">
  <link rel="apple-touch-icon" href="assets/logo/ft8tw-logo-180.png">
  <link rel="stylesheet" href="css/app.css">
  <link rel="stylesheet" href="css/cards.css">
  <link rel="stylesheet" href="css/js8chat.css">
  <link rel="stylesheet" href="css/phone.css">
  <script type="module" src="js/main.mjs"></script>
</head>
<body>
  <div id="splash" role="status" aria-live="polite">
    <img src="assets/logo/ft8tw-logo-192.png" width="112" height="112" alt="FT8TW">
    <div class="sp-bar"><div class="sp-fill"></div></div>
    <p><span class="sp-zh">正在添加能源，準備出發…</span><span class="sp-en" lang="en">Fueling up, ready for takeoff…</span></p>
  </div>
  <!-- 免責宣告（使用者 2026-10-08）：按「我同意」才能繼續 -->
  <dialog id="disclaimer" class="disclaimer" aria-labelledby="disclaimer-title" aria-describedby="disclaimer-text">
    <h2 id="disclaimer-title" data-i18n="page.disclaimer.title">測試版使用聲明</h2>
    <p id="disclaimer-text" data-i18n="page.disclaimer.text">目前還是在測試版階段，請勿讓電台在無人操作狀況下執行，避免電台因持續發射而燒毀。本程式為測試性質，不負責相關損失。</p>
    <div class="disclaimer-actions"><button type="button" id="disclaimer-agree" class="primary" data-i18n="page.disclaimer.agree">我同意</button></div>
  </dialog>
  <div id="tx-banner" class="tx-banner" role="status" title="拖曳可移動位置" data-i18n-attr="title:page.tx_banner_drag" hidden></div>
  <div id="slot-progress" class="slot-progress" role="progressbar" aria-label="解碼週期" data-i18n-attr="aria-label:page.slot_progress" aria-valuemin="0" aria-valuemax="100" hidden><div class="bar"></div></div>
  <!-- 青色跑馬條（add-dt-offset-advisor D20）：收訊音訊延遲 ≠ 0 時才顯示，緊貼橘色跑馬條下方；用接收切 slot 的時間（已扣收訊延遲） -->
  <div id="rx-slot-progress" class="rx-slot-progress" role="progressbar" aria-label="接收時槽" data-i18n-attr="aria-label:dtadvisor.rxBarShort" aria-valuemin="0" aria-valuemax="100" hidden><div class="bar"></div></div>
  <!-- 新版提示／強制更新等待（add-version-tracking，update.mjs）：有新版時可點（重新載入）；低於最低版本時顯示等待訊息 -->
  <button type="button" id="update-banner" class="update-banner" aria-live="polite" hidden></button>
  <!-- 時間偏差提醒（add-dt-offset-advisor，dtadvisor-ui.mjs）：與新版提示分開、可同時出現；不自動套用 -->
  <!-- 無障礙（D19）：只有文字是 live region（role=status），按鈕不在裡面 -->
  <div id="dt-banner" class="dt-banner" role="group" aria-label="時間偏差建議" data-i18n-attr="aria-label:dtadvisor.banner" hidden>
    <span id="dt-banner-text" class="dt-banner-text" role="status"></span>
    <span class="dt-banner-actions">
      <button type="button" id="dt-apply" data-i18n="dtadvisor.apply">套用</button>
      <button type="button" id="dt-ignore" class="secondary" data-i18n="dtadvisor.ignore">忽略</button>
    </span>
  </div>
  <!-- 手機的「取消偏差調整」（D21）：紫色頂列放不下，收訊延遲 ≠ 0 時在頂列上方顯示一條細列（桌機用模式下拉左邊那個） -->
  <div id="p-rxdelay-ctl" class="rxdelay-ctl p-rxdelay" hidden>
    <span id="p-rxdelay-label" class="rxdelay-label"></span>
    <button type="button" id="p-rxdelay-cancel" class="secondary rxdelay-cancel" data-i18n="dtadvisor.cancel">取消偏差調整</button>
    <span id="p-rxdelay-confirm" class="rxdelay-confirm" role="group" hidden>
      <span id="p-rxdelay-confirm-msg"></span>
      <button type="button" id="p-rxdelay-yes" class="danger" data-i18n="dtadvisor.cancelYes">歸零</button>
      <button type="button" id="p-rxdelay-no" class="secondary" data-i18n="dtadvisor.cancelNo">不要</button>
    </span>
  </div>
  <header class="topbar">
    <button id="menu-toggle" type="button" class="icon" aria-label="開啟設置選單" data-i18n-attr="aria-label:page.menu_open" aria-expanded="false" aria-controls="menu">
      <span aria-hidden="true">☰</span>
    </button>
    <div>
      <h1><img class="brand-logo" src="assets/logo/ft8tw-logo-64.png" width="32" height="32" alt=""><span data-i18n="page.title">FT8TW 網頁接收站</span> <span id="version" class="version"></span></h1>
      <!-- 摘要列（add-rig-meters M1）：呼號 · 網格（各欄 span）、模式下拉、頻率下拉（add-web-frequency-list），
           後面接電台資訊組（狀態點＋型號、與選的頻率不同時的電台實際頻率、S 表、SWR） -->
      <p class="sub summary-line">
        <span id="settings-summary" class="summary-text" aria-label="目前設定" data-i18n-attr="aria-label:page.settings_summary"></span>
        <!-- 模式下拉（使用者 2026-10-07 改成可直接切換；2026-10-09 移到頻率下拉左邊）；與設置頁的模式選項同步 -->
        <select id="mode-select" class="mode-select" aria-label="模式" title="切換模式" data-i18n-attr="aria-label:page.strip.mode;title:page.strip.mode">
          <option value="FT8">FT8</option><option value="FT4">FT4</option><option value="FT2">FT2</option><option value="JS8">JS8</option><option value="JTTY">JTTY</option>
        </select>
        <select id="freq-select" class="mode-select freq-select" aria-label="撥號頻率" title="切換撥號頻率" data-i18n-attr="aria-label:freq.select;title:freq.select_title"></select>
        <span id="rig-meters" class="rig-meters" role="group" aria-label="電台" data-i18n-attr="aria-label:rig.meters.group" hidden></span>
      </p>
    </div>
    <div class="status-strip">
      <!-- 取消偏差調整（add-dt-offset-advisor D21）：收訊音訊延遲 ≠ 0 時顯示在時槽秒數旁（使用者 2026-10-09：跟秒數比較有關連）；按下先行內確認 -->
      <span id="rxdelay-ctl" class="rxdelay-ctl" hidden>
        <button type="button" id="rxdelay-cancel" class="secondary rxdelay-cancel" data-i18n="dtadvisor.cancel">取消偏差調整</button>
        <span id="rxdelay-confirm" class="rxdelay-confirm" role="group" hidden>
          <span id="rxdelay-confirm-msg"></span>
          <button type="button" id="rxdelay-yes" class="danger" data-i18n="dtadvisor.cancelYes">歸零</button>
          <button type="button" id="rxdelay-no" class="secondary" data-i18n="dtadvisor.cancelNo">不要</button>
        </span>
      </span>
      <div id="slot-tick" class="slot-tick" hidden>
        <span id="slot-second" class="slot-second"></span>
      </div>
      <span class="strip-item" title="發射週期／目前週期" data-i18n-attr="title:page.strip.cycle_title"><span data-i18n="page.strip.cycle">週期</span> <strong id="strip-cycle">-/-</strong></span>
      <span class="strip-item">UTC <strong id="strip-utc">--:--:--</strong></span>
      <button id="strip-tx" type="button" class="tx-toggle" aria-pressed="false" title="開始發射（呼叫 CQ）／停止發射" data-i18n-attr="title:page.strip.tx_title">
        <span aria-hidden="true" id="strip-tx-icon">🔇</span> <span id="strip-tx-label" data-i18n="page.strip.tx">發射</span>
      </button>
    </div>
    <!-- 手機每頁工具列（web-phone-app-layout，同 App 紫色工具列；圖示由 phone-ui.mjs 依 data-icon 填入）：平板／桌機不顯示（phone.css） -->
    <div class="pbar pbar-decode" role="toolbar" aria-label="解碼" data-i18n-attr="aria-label:page.tab.decode">
      <button id="pbar-decode-clear" type="button" class="pbar-btn" data-icon="clear" aria-label="清除解碼清單" data-i18n-attr="aria-label:page.decode.clear"></button>
      <span class="pbar-l1" id="pbar-offset"></span>
      <span class="pbar-r1" id="pbar-grid"></span>
      <span class="pbar-l2"><span class="pbar-badge"></span><span id="pbar-decode-ms"></span></span>
      <span class="pbar-r2 pbar-utc"></span>
      <span class="pbar-mid"><select class="pbar-freqsel freq-select" aria-label="撥號頻率" data-i18n-attr="aria-label:freq.select"></select><span class="pbar-rig rig-meters" role="group" aria-label="電台" data-i18n-attr="aria-label:rig.meters.group" hidden></span></span>
      <button id="pbar-rx" type="button" class="pbar-btn" data-icon="micOff" aria-pressed="false" aria-label="接收開關" data-i18n-attr="aria-label:page.pbar.rx"></button>
    </div>
    <div class="pbar pbar-call" role="toolbar" aria-label="呼叫" data-i18n-attr="aria-label:page.tab.call">
      <button id="pbar-call-clear" type="button" class="pbar-btn" data-icon="clear" aria-label="清除呼叫清單" data-i18n-attr="aria-label:page.call.clear"></button>
      <span class="pbar-l1"><span id="pbar-target"></span><button id="pbar-edit" type="button" class="pbar-edit" data-icon="edit" aria-expanded="false" aria-label="通聯與發射" data-i18n-attr="aria-label:page.pbar.edit"></button></span>
      <span class="pbar-r1" id="pbar-freq"></span>
      <span class="pbar-l2"><span class="pbar-badge"></span><span id="pbar-cycle"></span></span>
      <span class="pbar-r2 pbar-utc"></span>
      <span class="pbar-mid"><select class="pbar-freqsel freq-select" aria-label="撥號頻率" data-i18n-attr="aria-label:freq.select"></select><span class="pbar-rig rig-meters" role="group" aria-label="電台" data-i18n-attr="aria-label:rig.meters.group" hidden></span></span>
      <button id="pbar-tx" type="button" class="pbar-btn" data-icon="txOff" aria-pressed="false" aria-label="發射開關" data-i18n-attr="aria-label:page.pbar.tx"></button>
    </div>
  </header>

  <div id="menu-backdrop" class="backdrop" hidden></div>
  <!-- 左上角抽屜＝FT8TW 的「設置」：主選單 8 個區段，點入顯示該區段（config/ui.mjs）。
       設定項目沿用原本的 element id（callsign、grid、band、device、tx-freq…），settings-ui.mjs、tx/ui.mjs 照常運作 -->
  <aside id="menu" class="drawer" aria-labelledby="menu-title" hidden>
    <div class="drawer-head">
      <h2 id="menu-title" data-i18n="config.title">設置</h2>
      <!-- 快速切換語言（使用者 2026-10-07）：標題右邊、圖示＋目前語言，外國人不必看懂中文也找得到；與「顯示與佈景」的語言卡片同一個設定 -->
      <label class="lang-quick" title="Language / 語言" data-i18n-skip>
        <span aria-hidden="true">🌐</span>
        <select id="menu-language" aria-label="Language / 語言">
          <option value="auto" data-i18n="config.languageAutoShort">自動</option>
          <option value="en" lang="en">English</option>
          <option value="zh-TW" lang="zh-Hant">中文</option>
        </select>
      </label>
      <button id="menu-close" type="button" class="icon" aria-label="關閉設置選單" data-i18n-attr="aria-label:config.close"><span aria-hidden="true">✕</span></button>
    </div>

    <div class="cfg-profile">
      <label for="cfg-profile" data-i18n="config.profile">設定組：</label>
      <select id="cfg-profile"><option value="1" data-i18n="config.profileDefault">預設</option></select>
      <button id="cfg-profile-add" type="button" class="profile-btn" aria-label="新增設定組" data-i18n-attr="aria-label:config.profileAdd">＋</button>
      <button id="cfg-profile-rename" type="button" class="profile-btn" aria-label="重新命名設定組" data-i18n-attr="aria-label:config.profileRename">✎</button>
      <button id="cfg-profile-delete" type="button" class="profile-btn" aria-label="刪除設定組" data-i18n-attr="aria-label:config.profileDelete">✕</button>
      <button type="button" class="info" data-help="profile" aria-label="說明：設定組" data-i18n-attr="aria-label:config.help.profile">i</button>
      <small class="cfg-profile-hint" data-i18n="config.profileHint">◀ 紫色條紋＝隨設定組切換</small>
    </div>
    <div id="cfg-profile-edit" class="cfg-confirm cfg-profile-edit" hidden>
      <label for="cfg-profile-name" id="cfg-profile-edit-title"></label>
      <input id="cfg-profile-name" maxlength="24" aria-describedby="cfg-profile-msg" autocomplete="off" spellcheck="false" placeholder="設定組名稱" data-i18n-attr="placeholder:config.profileNameHint">
      <div class="actions">
        <button id="cfg-profile-ok" type="button" data-i18n="config.ok">確定</button>
        <button id="cfg-profile-cancel" type="button" class="secondary" data-i18n="config.cancel">取消</button>
      </div>
    </div>
    <div id="cfg-profile-del" class="cfg-confirm" role="group" aria-labelledby="cfg-profile-del-msg" hidden>
      <p id="cfg-profile-del-msg" class="warn"></p>
      <div class="actions">
        <button id="cfg-profile-del-go" type="button" class="danger" data-i18n="config.profileDeleteGo">刪除</button>
        <button id="cfg-profile-del-cancel" type="button" class="secondary" data-i18n="config.cancel">取消</button>
      </div>
    </div>
    <div id="cfg-profile-switch" class="cfg-confirm" role="group" aria-labelledby="cfg-profile-switch-msg" hidden>
      <p id="cfg-profile-switch-msg" class="warn"></p>
      <div class="actions">
        <button id="cfg-profile-switch-go" type="button" data-i18n="config.profileSwitchGo">切換</button>
        <button id="cfg-profile-switch-cancel" type="button" class="secondary" data-i18n="config.cancel">取消</button>
      </div>
    </div>
    <p id="cfg-profile-msg" class="hint" aria-live="polite"></p>
    <p id="cfg-invalid" class="warn" role="status" hidden></p>

    <!-- 主選單 -->
    <nav id="cfg-home" class="cfg-page" aria-label="設定區段" data-i18n-attr="aria-label:config.sections">
      <ul class="cfg-menu">
        <li><button type="button" data-page="basic" data-i18n="config.section.basic">基本資訊</button></li>
        <li><button type="button" data-page="autoqso" data-i18n="config.section.autoqso">自動通聯</button></li>
        <li><button type="button" data-page="rig" data-i18n="config.section.rig">電台與聲音</button></li>
        <li><button type="button" data-page="upload" data-i18n="config.section.upload">上傳至第三方</button></li>
        <li><button type="button" data-page="activation" data-i18n="config.section.activation">SOTA / POTA 出勤</button></li>
        <li><button type="button" data-page="display" data-i18n="config.section.display">顯示與佈景</button></li>
        <li><button type="button" data-page="backup" data-i18n="config.section.backup">備份與還原</button></li>
        <li><button type="button" data-page="advanced" data-i18n="config.section.advanced">進階與開發者</button></li>
      </ul>
      <ul class="cfg-menu">
        <li><button type="button" data-page="swllog" data-i18n="config.section.swllog">SWL Log（收聽記錄）</button></li>
        <!-- 更新歷程（使用者 2026-10-09：另開一頁；資料在 js/changelog.mjs）。放在「關於」上面，Ko-fi 維持緊接「關於」下方 -->
        <li><button type="button" data-page="changelog" data-i18n="config.section.changelog">更新歷程</button></li>
        <li><button type="button" data-page="about" data-i18n="config.section.about">關於</button></li>
        <!-- 支持 FT8TW 開發（使用者 2026-10-07：放在漢堡選單「關於」下方；同 App 用 Ko-fi） -->
        <li><a id="cfg-donate" class="donate-link" href="https://ko-fi.com/bv6lc" target="_blank" rel="noopener" title="贊助完全出於自願，不會解鎖任何功能。" data-i18n-attr="title:config.donateFooter"><span data-i18n="config.donateTitle">☕ 支持 FT8TW 開發</span></a></li>
      </ul>
      <p class="hint" data-i18n="config.homeNote">FT8TW 是 BG7YOZ 所開發 FT8CN 的分支，感謝原作者。網頁版的設定存在這個瀏覽器裡。</p>
    </nav>

    <!-- 1 基本資訊 -->
    <section id="cfg-page-basic" class="cfg-page" data-page="basic" aria-label="基本資訊" data-i18n-attr="aria-label:config.section.basic" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="callsign" class="cfg-label" data-i18n="config.callsign">我的呼號</label>
            <input id="callsign" class="cfg-short" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="例如 BV6LC" data-i18n-attr="placeholder:config.callsignPlaceholder">
            <label for="cfg-cq-modifier" class="cfg-label" data-i18n="config.cqModifier">CQ 對象</label>
            <input id="cfg-cq-modifier" class="cfg-tiny" data-cfg="cqModifier" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="4" placeholder="POTA" aria-describedby="cq-modifier-error">
          </div>
          <small class="error" id="callsign-error"></small>
          <small class="error" id="cq-modifier-error"></small>
          <small class="hint" data-i18n="config.callsignHint">呼號與網格都填好、而且取得時間校正後，才會回報到 PSKReporter。</small>
        </div>
        <button type="button" class="info" data-help="callsign" aria-label="說明：我的呼號" data-i18n-attr="aria-label:config.help.callsign">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="grid" class="cfg-label" data-i18n="config.grid">我的位置</label>
            <input id="grid" class="cfg-short" autocomplete="off" spellcheck="false" placeholder="例如 PL05sb" data-i18n-attr="placeholder:config.gridPlaceholder" maxlength="6" aria-describedby="locate-msg">
            <button id="locate" type="button" class="secondary" data-i18n="config.locate">用目前位置</button>
          </div>
          <small class="error" id="grid-error"></small>
          <small class="hint" id="locate-msg" data-i18n="config.locateHint">只換算成 6 碼網格，經緯度不會保存或送出</small>
        </div>
        <button type="button" class="info" data-help="maidenhead" aria-label="說明：我的位置" data-i18n-attr="aria-label:config.help.grid">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-time-offset" class="cfg-label" data-i18n="config.timeOffset">時間偏移</label>
            <select id="cfg-time-offset" class="cfg-auto" data-cfg="timeOffsetMs"></select>
            <button id="cfg-time-sync" type="button" class="secondary" data-i18n="config.timeSync">同步時間</button>
          </div>
          <small class="hint" id="cfg-clock-detail" aria-live="polite"></small>
          <small class="hint" data-i18n="config.timeOffsetHint">開網頁時自動向轉送站校時，之後每 10 分鐘一次；手動偏移加在校時結果上，連不到轉送站或音效卡有固定延遲時才需要調。</small>
        </div>
        <button type="button" class="info" data-help="timeoffset" aria-label="說明：時間偏移" data-i18n-attr="aria-label:config.help.timeOffset">i</button>
      </div>
      <!-- 載波頻段（add-web-frequency-list Q3）：與摘要列、手機頂列同一份頻率下拉（freq-ui.mjs），旁邊編輯頻率表（全域，不隨設定組） -->
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="band" class="cfg-label" data-i18n="config.band">載波頻段</label>
            <select id="band" class="freq-select"></select>
            <button id="freqtable-open" type="button" class="secondary" data-i18n="config.freqTableEdit">編輯頻率表</button>
          </div>
          <small class="hint" id="dial"></small>
        </div>
        <button type="button" class="info" data-help="band" aria-label="說明：載波頻段" data-i18n-attr="aria-label:config.help.band">i</button>
      </div>
      <!-- 頻率表編輯（同 FT8TW 頻率表編輯）：每個模式一份；新增、修改、刪除、標常用、恢復預設 -->
      <dialog id="freqtable-dialog" class="freqtable" aria-labelledby="freqtable-title">
        <h3 id="freqtable-title" data-i18n="freq.title">編輯頻率表</h3>
        <div class="freqtable-head">
          <label for="freqtable-mode" data-i18n="freq.mode">模式</label>
          <select id="freqtable-mode" class="cfg-auto">
            <option value="FT8">FT8</option><option value="FT4">FT4</option><option value="FT2">FT2</option><option value="JS8">JS8</option><option value="JTTY">JTTY</option>
          </select>
          <small class="hint" data-i18n="freq.shared">全部設定組共用</small>
        </div>
        <ul id="freqtable-list" class="freqtable-list" aria-labelledby="freqtable-title"></ul>
        <form id="freqtable-form" class="freqtable-form" novalidate>
          <label for="freqtable-mhz" data-i18n="freq.mhz">頻率（MHz）</label>
          <input id="freqtable-mhz" type="text" inputmode="decimal" autocomplete="off" placeholder="14.074" aria-describedby="freqtable-error">
          <label class="check"><input id="freqtable-marked" type="checkbox"> <span data-i18n="freq.marked">常用 ★</span></label>
          <button id="freqtable-save" type="submit" data-i18n="freq.add">新增</button>
          <button id="freqtable-cancel" type="button" class="secondary" data-i18n="common.cancel" hidden>取消</button>
          <small id="freqtable-error" class="freqtable-msg" aria-live="polite"></small>
        </form>
        <div class="freqtable-actions">
          <button id="freqtable-reset" type="button" class="secondary" data-i18n="freq.reset">恢復預設</button>
          <button id="freqtable-close" type="button" data-i18n="common.close">關閉</button>
        </div>
      </dialog>
      <div class="cfg-card">
        <div class="cfg-body">
          <fieldset class="cfg-line mode">
            <legend class="cfg-label" data-i18n="config.mode">FT8/FT4/FT2/JS8 模式</legend>
            <label><input type="radio" name="mode" value="FT8" checked> FT8</label>
            <label><input type="radio" name="mode" value="FT4"> FT4</label>
            <label><input type="radio" name="mode" value="JS8"> JS8</label>
            <label title="FT8TW 自訂模式，只能與 FT8TW 互通" data-i18n-attr="title:config.ft2Title"><input type="radio" name="mode" value="FT2"> FT2<small class="hint" data-i18n="config.ft2Only">（僅 FT8TW 互通）</small></label>
            <label><input type="radio" name="mode" value="JTTY"> JTTY</label>
          </fieldset>
        </div>
        <button type="button" class="info" data-help="mode" aria-label="說明：模式" data-i18n-attr="aria-label:config.help.mode">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <div class="cfg-line">
            <span class="cfg-label" data-i18n="config.decodeMode">解碼模式</span>
            <select disabled aria-label="解碼模式" data-i18n-attr="aria-label:config.decodeMode"><option data-i18n="config.decodeModeStandard">標準（平衡）</option></select>
          </div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="decodeMode" aria-label="說明：解碼模式" data-i18n-attr="aria-label:config.help.decodeMode">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.contestMode">競賽模式（交換網格）</span><input type="checkbox" role="switch" disabled></label>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.fieldDayMode">野外日模式（ARRL FD 交換）</span><input type="checkbox" role="switch" disabled></label>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.autostart">開啟網頁時自動開始接收</span><input id="autostart" type="checkbox" role="switch" checked></label>
        </div>
        <button type="button" class="info" data-help="autostart" aria-label="說明：自動開始接收" data-i18n-attr="aria-label:config.help.autostart">i</button>
      </div>
    </section>

    <!-- 2 自動通聯（設定先保存，通聯流程 T2 讀取） -->
    <section id="cfg-page-autoqso" class="cfg-page" data-page="autoqso" aria-label="自動通聯" data-i18n-attr="aria-label:config.section.autoqso" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <p class="hint" data-i18n="config.autoqsoNote">自動通聯功能開發中：這裡的設定會先保存，通聯功能完成後生效。</p>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.noSaveDecodes">不保存解碼</span><input type="checkbox" role="switch" disabled></label>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.noSaveSwl">不保存 SWL 記錄</span><input type="checkbox" role="switch" disabled></label>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="swl" aria-label="說明：SWL" data-i18n-attr="aria-label:config.help.swl">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.label.autoFollowCQ">自動回應 CQ</span><input id="cfg-auto-follow" type="checkbox" role="switch" data-cfg="autoFollowCQ"></label>
          <div class="cfg-line">
            <label for="cfg-cq-order" class="cfg-label" data-i18n="config.label.autoFollowCQOrder">回應 CQ 方案</label>
            <select id="cfg-cq-order" data-cfg="autoFollowCQOrder"></select>
          </div>
          <div class="cfg-line">
            <label for="cfg-qso-filter" class="cfg-label" data-i18n="config.label.qsoFilterOpt">排除已通聯</label>
            <select id="cfg-qso-filter" data-cfg="qsoFilterOpt"></select>
          </div>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.showWorked">顯示已通聯站台（加刪除線）</span><input id="cfg-show-worked" type="checkbox" role="switch" data-cfg="showWorkedStations"></label>
        </div>
        <button type="button" class="info" data-help="autoFollow" aria-label="說明：自動回應 CQ" data-i18n-attr="aria-label:config.help.autoFollow">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-follow-input" class="cfg-label" data-i18n="config.label.followCallsigns">關注呼號</label>
            <input id="cfg-follow-input" class="cfg-short" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="關注的呼號" data-i18n-attr="placeholder:config.followPlaceholder">
            <button id="cfg-follow-add" type="button" class="secondary" data-i18n="config.followAdd">新增關注</button>
          </div>
          <ul id="cfg-follow-list" class="chips" aria-label="已關注的呼號" data-i18n-attr="aria-label:config.followList"></ul>
        </div>
        <button type="button" class="info" data-help="followCalls" aria-label="說明：關注呼號" data-i18n-attr="aria-label:config.help.followCalls">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-excluded" class="cfg-label" data-i18n="config.label.excludedCallsigns">排除的呼號前綴</label>
            <input id="cfg-excluded" data-cfg="excludedCallsigns" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="請輸入呼號前綴，以逗號或空白分隔" data-i18n-attr="placeholder:config.excludedPlaceholder">
          </div>
        </div>
        <button type="button" class="info" data-help="excluded" aria-label="說明：排除的呼號前綴" data-i18n-attr="aria-label:config.help.excluded">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-supervision" class="cfg-label" data-i18n="config.label.launchSupervisionMin">發射監管</label>
            <select id="cfg-supervision" class="cfg-auto" data-cfg="launchSupervisionMin"></select>
          </div>
          <small class="hint" data-i18n="config.supervisionHint">試驗期發射一律連續 15 分鐘自動停止。</small>
        </div>
        <button type="button" class="info" data-help="supervision" aria-label="說明：發射監管" data-i18n-attr="aria-label:config.help.supervision">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-no-reply" class="cfg-label" data-i18n="config.noReply">沒回應</label>
            <select id="cfg-no-reply" class="cfg-auto" data-cfg="noReplyLimit"></select>
            <span data-i18n="config.noReplySuffix">中斷呼叫</span>
          </div>
        </div>
        <button type="button" class="info" data-help="noReply" aria-label="說明：沒回應中斷呼叫" data-i18n-attr="aria-label:config.help.noReply">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-finish-retry" class="cfg-label" data-i18n="config.label.finishRetryLimit">收尾最多重發</label>
            <select id="cfg-finish-retry" class="cfg-auto" data-cfg="finishRetryLimit"></select>
            <span data-i18n="config.finishRetrySuffix">（對方重呼時）</span>
          </div>
        </div>
        <button type="button" class="info" data-help="finishRetry" aria-label="說明：收尾最多重發" data-i18n-attr="aria-label:config.help.finishRetry">i</button>
      </div>
    </section>

    <!-- 3 電台與聲音 -->
    <section id="cfg-page-rig" class="cfg-page" data-page="rig" aria-label="電台與聲音" data-i18n-attr="aria-label:config.section.rig" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card" id="rig-card">
        <div class="cfg-body">
          <div class="cfg-line" id="rig-wiz-line" hidden>
            <button id="rig-wiz-open" type="button" data-i18n="rig.wiz.open">自動設定精靈</button>
            <small class="hint" data-i18n="rig.wiz.openHint">自動找電台、設定 CAT 與音效裝置，並指導收發音量</small>
          </div>
          <div class="cfg-line">
            <label for="rig-control" class="cfg-label" data-i18n="rig.control">控制方式</label>
            <select id="rig-control">
              <option value="vox" data-i18n="rig.mode.vox">VOX（網頁不控制 PTT）</option>
              <option value="cat" data-i18n="rig.mode.cat">CAT（以指令控制 PTT）</option>
              <option value="rts" data-i18n="rig.mode.rts">RTS 控制線（PTT）</option>
              <option value="dtr" data-i18n="rig.mode.dtr">DTR 控制線（PTT）</option>
            </select>
          </div>
          <p id="rig-unsupported" class="hint" data-i18n="rig.unsupported" hidden>這個瀏覽器不支援 Web Serial，網頁無法控制電台。</p>
          <div id="rig-cat" class="rig-cat" hidden>
            <div class="cfg-line">
              <label for="rig-model" class="cfg-label" data-i18n="rig.model">電台型號</label>
              <select id="rig-model"></select>
            </div>
            <div class="cfg-line">
              <label for="rig-baud" class="cfg-label" data-i18n="rig.baud">鮑率</label>
              <select id="rig-baud" class="cfg-short"></select>
            </div>
            <div class="cfg-line">
              <span class="cfg-label" data-i18n="rig.framing">資料／停止／同位</span>
              <select id="rig-databits" class="cfg-tiny" aria-label="資料位元" data-i18n-attr="aria-label:rig.dataBits"><option value="8">8</option><option value="7">7</option></select>
              <select id="rig-stopbits" class="cfg-tiny" aria-label="停止位元" data-i18n-attr="aria-label:rig.stopBits"><option value="1">1</option><option value="2">2</option></select>
              <select id="rig-parity" class="cfg-tiny" aria-label="同位" data-i18n-attr="aria-label:rig.parity">
                <option value="none" data-i18n="rig.parity.none">無</option><option value="even" data-i18n="rig.parity.even">偶</option><option value="odd" data-i18n="rig.parity.odd">奇</option>
              </select>
            </div>
            <div class="cfg-line" id="rig-civ-line">
              <label for="rig-civ" class="cfg-label" data-i18n="rig.civ">CI-V 位址（16 進位）</label>
              <input id="rig-civ" class="cfg-short" maxlength="2" autocomplete="off" spellcheck="false">
            </div>
            <div class="cfg-line">
              <label for="rig-ptt-delay" class="cfg-label" data-i18n="rig.pttDelay">PTT 延遲（ms）</label>
              <input id="rig-ptt-delay" class="cfg-short" type="number" min="0" max="1000" step="10">
            </div>
            <p id="rig-field-error" class="hint error" aria-live="polite"></p>
            <div class="cfg-line rig-actions">
              <button id="rig-port" type="button" class="secondary" data-i18n="rig.choosePort">選擇序列埠</button>
              <button id="rig-connect" type="button" class="secondary" data-i18n="rig.connect">連線</button>
              <button id="rig-test" type="button" class="secondary" data-i18n="rig.test">測試</button>
            </div>
            <p id="rig-status" class="hint" aria-live="polite"></p>
            <p id="rig-warning" class="hint error" aria-live="polite" hidden></p>
            <p id="rig-ptt-stuck" class="rig-ptt-stuck" role="alert" aria-live="assertive" hidden></p>
            <p id="rig-noswr" class="hint" data-i18n="rig.noSwr" hidden>這個機型不讀 SWR</p>
          </div>
        </div>
        <button type="button" class="info" data-help="rigControl" aria-label="說明：控制方式" data-i18n-attr="aria-label:config.help.control">i</button>
      </div>
      <!-- 電台自動設定精靈（add-rig-autosetup）：web/js/rig/wizard-ui.mjs -->
      <dialog id="rig-wiz" class="rig-wiz" aria-labelledby="rig-wiz-title">
        <h3 id="rig-wiz-title" data-i18n="rig.wiz.title">電台自動設定</h3>
        <ol class="rig-wiz-steps" id="rig-wiz-steps"></ol>

        <section data-step="safety">
          <fieldset>
            <legend data-i18n="rig.wiz.controlQ">電台的 PTT 怎麼控制？</legend>
            <label class="check"><input type="radio" name="rig-wiz-mode" value="cat" checked> <span data-i18n="rig.mode.cat">CAT（以指令控制 PTT）</span></label>
            <label class="check"><input type="radio" name="rig-wiz-mode" value="rts"> <span data-i18n="rig.mode.rts">RTS 控制線（PTT）</span></label>
            <label class="check"><input type="radio" name="rig-wiz-mode" value="dtr"> <span data-i18n="rig.mode.dtr">DTR 控制線（PTT）</span></label>
            <label class="check"><input type="radio" name="rig-wiz-mode" value="vox"> <span data-i18n="rig.mode.vox">VOX（網頁不控制 PTT）</span></label>
          </fieldset>
          <fieldset id="rig-wiz-y5-set">
            <legend data-i18n="rig.wiz.y5Q">是舊款 Yaesu 嗎（FT-817／818／857／897／847）？</legend>
            <small class="hint" data-i18n="rig.wiz.y5Help">QMX、QDX、ICOM、Kenwood、Elecraft、新款 Yaesu（FT-991、FT-DX10…）等都選「不是」</small>
            <label class="check"><input type="radio" name="rig-wiz-y5" value="no"> <span data-i18n="rig.wiz.no">不是</span></label>
            <label class="check"><input type="radio" name="rig-wiz-y5" value="yes"> <span data-i18n="rig.wiz.yes">是</span></label>
            <label class="check"><input type="radio" name="rig-wiz-y5" value="unsure"> <span data-i18n="rig.wiz.unsure">不確定</span></label>
          </fieldset>
          <p class="hint" id="rig-wiz-safety-hint" aria-live="polite"></p>
        </section>

        <section data-step="port" hidden>
          <p data-i18n="rig.wiz.portIntro">用 USB 線接好電台並開機，再選序列埠。清單只列常見的電台 USB 晶片；找不到時按「顯示全部埠」。</p>
          <div class="actions">
            <button id="rig-wiz-port" type="button" class="secondary" data-i18n="rig.choosePort">選擇序列埠</button>
            <button id="rig-wiz-port-all" type="button" class="secondary" data-i18n="rig.wiz.portAll">顯示全部埠</button>
          </div>
          <p class="hint" id="rig-wiz-port-msg" aria-live="polite"></p>
        </section>

        <section data-step="probe" hidden>
          <div id="rig-wiz-scan">
            <p data-i18n="rig.wiz.probeIntro">網頁會用不同鮑率送唯讀查詢（不會發射、不會改電台設定），找出電台型號，約需 10 秒。</p>
            <div class="actions">
              <button id="rig-wiz-probe" type="button" class="secondary" data-i18n="rig.wiz.probeStart">開始偵測</button>
              <button id="rig-wiz-probe-cancel" type="button" class="secondary" data-i18n="config.cancel" hidden>取消</button>
            </div>
          </div>
          <p class="hint" id="rig-wiz-probe-msg" aria-live="polite"></p>
          <div class="cfg-line" id="rig-wiz-pick-line" hidden>
            <label for="rig-wiz-model" class="cfg-label" data-i18n="rig.model">電台型號</label>
            <select id="rig-wiz-model"></select>
          </div>
          <div class="actions"><button id="rig-wiz-apply" type="button" data-i18n="rig.wiz.apply" hidden>套用並連線</button></div>
          <p class="hint" id="rig-wiz-apply-msg" aria-live="polite"></p>
        </section>

        <section data-step="input" hidden>
          <p data-i18n="rig.wiz.inputIntro">選電台的音效輸入（名稱常含 USB Audio CODEC 或電台型號）；不確定就按「自動偵測」，會挑解碼最多的輸入（約 30 秒）。</p>
          <div class="cfg-line">
            <label for="rig-wiz-input" class="cfg-label" data-i18n="config.audioInput">音訊輸入</label>
            <select id="rig-wiz-input"></select>
          </div>
          <div class="actions"><button id="rig-wiz-detect" type="button" class="secondary" data-i18n="config.detect">自動偵測</button></div>
          <div class="rig-wiz-meter">
            <span data-i18n="rig.wiz.rxLevel">收訊電平</span>
            <meter id="rig-wiz-rx-meter" min="-90" max="0" low="-60" high="-6" optimum="-40" value="-90"></meter>
            <output id="rig-wiz-rx-db"></output>
          </div>
          <p class="hint" id="rig-wiz-rx-msg" aria-live="polite"></p>
        </section>

        <section data-step="output" hidden>
          <p data-i18n="rig.wiz.outputIntro">選電台的音效輸出（發射音訊從這裡送到電台）。</p>
          <div class="cfg-line">
            <label for="rig-wiz-output" class="cfg-label" data-i18n="config.txDevice">輸出裝置</label>
            <select id="rig-wiz-output"></select>
          </div>
          <p class="hint" id="rig-wiz-output-msg" aria-live="polite"></p>
        </section>

        <section data-step="tx" hidden>
          <p class="warn" data-i18n="rig.wiz.txWarn">按住按鈕時電台會真的發射 1000 Hz 單音（最長 15 秒）。請先調低功率、接好天線或假負載，並確認這個頻率現在沒人使用。</p>
          <label class="check"><input id="rig-wiz-tx-ok" type="checkbox"> <span data-i18n="rig.wiz.txConfirm">已接天線或假負載，頻率沒人使用</span></label>
          <div class="cfg-line">
            <label for="rig-wiz-gain" class="cfg-label" data-i18n="config.txLevel">發射電平</label>
            <input id="rig-wiz-gain" class="cfg-range" type="range" min="0" max="1" step="0.01">
            <output id="rig-wiz-gain-value" for="rig-wiz-gain"></output>
          </div>
          <div class="actions"><button id="rig-wiz-hold" type="button" class="danger" data-i18n="rig.wiz.hold" disabled>按住發射</button></div>
          <dl class="rig-wiz-readout">
            <dt data-i18n="rig.wiz.alc">ALC</dt><dd id="rig-wiz-alc">—</dd>
            <dt data-i18n="rig.wiz.power">功率</dt><dd id="rig-wiz-power">—</dd>
            <dt>SWR</dt><dd id="rig-wiz-swr">—</dd>
          </dl>
          <p class="hint" id="rig-wiz-tx-msg" aria-live="polite"></p>
        </section>

        <div class="rig-wiz-nav">
          <button id="rig-wiz-back" type="button" class="secondary" data-i18n="rig.wiz.back">上一步</button>
          <button id="rig-wiz-skip" type="button" class="secondary" data-i18n="rig.wiz.skip">略過</button>
          <button id="rig-wiz-next" type="button" data-i18n="rig.wiz.next">下一步</button>
          <button id="rig-wiz-close" type="button" class="secondary" data-i18n="rig.wiz.close">關閉</button>
        </div>
      </dialog>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="device" class="cfg-label" data-i18n="config.audioInput">音訊輸入</label>
            <select id="device"><option value="" data-i18n="config.defaultDevice">（預設裝置）</option></select>
          </div>
          <div class="cfg-line"><button id="detect" type="button" class="secondary" data-i18n="config.detect">自動偵測</button></div>
          <ul id="detect-result" class="detect-result" aria-live="polite"></ul>
        </div>
        <button type="button" class="info" data-help="audioInput" aria-label="說明：音訊輸入" data-i18n-attr="aria-label:config.help.audioInput">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-rx-delay" class="cfg-label" data-i18n="config.rxAudioDelay">收訊音訊延遲</label>
            <select id="cfg-rx-delay" class="cfg-auto" data-cfg="rxAudioDelayMs"></select>
          </div>
          <small class="hint" data-i18n="config.rxAudioDelayHint">音訊比實際空中晚到多少（例如 WebSDR 經喇叭收音）。只影響接收，不影響發射時間。</small>
        </div>
        <button type="button" class="info" data-help="rxAudioDelay" aria-label="說明：收訊音訊延遲" data-i18n-attr="aria-label:config.help.rxAudioDelay">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.dtAdvisorLabel">自動偵測時間偏差</span><input id="cfg-dt-advisor" type="checkbox" role="switch" data-cfg="dtAdvisor"></label>
          <small class="hint" data-i18n="config.dtAdvisorHint">FT8／FT4 解出的訊號時間偏差太大、或完全解不到時，建議收訊音訊延遲（例如 WebSDR 的延遲）；要按「套用」才會改。</small>
        </div>
        <button type="button" class="info" data-help="dtAdvisor" aria-label="說明：自動偵測時間偏差" data-i18n-attr="aria-label:config.help.dtAdvisor">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="tx-freq" class="cfg-label" data-i18n="config.txFreq">預設頻率（Hz）</label>
            <input id="tx-freq" class="cfg-short" type="number" min="200" max="3000" step="1">
          </div>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.label.synFrequency">同頻發射</span><input id="cfg-syn-freq" type="checkbox" role="switch" data-cfg="synFrequency"></label>
        </div>
        <button type="button" class="info" data-help="txFreq" aria-label="說明：發射頻率" data-i18n-attr="aria-label:config.help.txFreq">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="tx-device" class="cfg-label" data-i18n="config.txDevice">輸出裝置</label>
            <select id="tx-device"><option value="" data-i18n="config.systemDefault">（系統預設）</option></select>
          </div>
          <small class="hint" id="tx-device-hint"></small>
        </div>
        <button type="button" class="info" data-help="txDevice" aria-label="說明：輸出裝置" data-i18n-attr="aria-label:config.help.txDevice">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="tx-gain" class="cfg-label" data-i18n="config.txLevel">發射電平</label>
            <output id="tx-gain-value" for="tx-gain"></output>
          </div>
          <input id="tx-gain" class="cfg-range" type="range" min="0" max="1" step="0.05">
          <div class="cfg-line">
            <button id="cfg-test-tone" type="button" class="secondary" data-i18n="config.testTone">測試音</button>
          </div>
          <div id="cfg-tone-confirm" class="cfg-confirm" role="alertdialog" aria-labelledby="cfg-tone-warn" hidden>
            <p id="cfg-tone-warn" class="warn" data-i18n="config.toneWarn">測試音會從所選輸出播放 1 秒 1000 Hz，經 VOX 讓電台真的發射。請確認電台頻率合法、接著天線或假負載。確定播放？</p>
            <div class="actions">
              <button id="cfg-tone-go" type="button" class="danger" data-i18n="config.toneGo">確定播放</button>
              <button id="cfg-tone-cancel" type="button" class="secondary" data-i18n="config.cancel">取消</button>
            </div>
          </div>
          <p id="cfg-tone-msg" class="hint" aria-live="polite"></p>
        </div>
        <button type="button" class="info" data-help="txLevel" aria-label="說明：發射電平與測試音" data-i18n-attr="aria-label:config.help.txLevel">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.inputLevel">接收音訊電平</span><meter min="0" max="1" value="0" aria-label="接收音訊電平" data-i18n-attr="aria-label:config.inputLevel"></meter></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
      </div>
    </section>

    <!-- 4 上傳至第三方 -->
    <section id="cfg-page-upload" class="cfg-page" data-page="upload" aria-label="上傳至第三方" data-i18n-attr="aria-label:config.section.upload" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.qrzAuto">自動上傳至 QRZ.com</span><input type="checkbox" role="switch" disabled></label>
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.apiKey">API 金鑰</span><input disabled aria-label="QRZ API 金鑰" data-i18n-attr="aria-label:config.qrzApiKey"></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="qrz" aria-label="說明：QRZ" data-i18n-attr="aria-label:config.help.qrz">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.cloudlogAuto">自動上傳至 Cloudlog / Wavelog</span><input type="checkbox" role="switch" disabled></label>
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.serverAddress">伺服器地址</span><input disabled placeholder="https://log.example.com" aria-label="Cloudlog 伺服器地址" data-i18n-attr="aria-label:config.cloudlogServer"></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="cloudlog" aria-label="說明：Cloudlog / Wavelog" data-i18n-attr="aria-label:config.help.cloudlog">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.lotwAuto">LoTW 自動下載確認</span><input type="checkbox" role="switch" disabled></label>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="lotw" aria-label="說明：LoTW" data-i18n-attr="aria-label:config.help.lotw">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.pskSpotsLabel">回報收到的訊號到 PSK Reporter</span><input id="cfg-psk-spots" type="checkbox" role="switch" data-cfg="pskSpots"></label>
        </div>
        <button type="button" class="info" data-help="pskSpots" aria-label="說明：回報收到的訊號" data-i18n-attr="aria-label:config.help.pskSpots">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.pskQsoLabel">回報網頁完成的通聯到 PSK Reporter</span><input id="cfg-psk-qso" type="checkbox" role="switch" data-cfg="pskQso"></label>
          <small class="hint" data-i18n="config.pskQsoHint">通聯功能完成後生效。</small>
        </div>
        <button type="button" class="info" data-help="pskQso" aria-label="說明：回報通聯" data-i18n-attr="aria-label:config.help.pskQso">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.antenna">天線資訊</span><input disabled placeholder="天線型號" aria-label="天線資訊" data-i18n-attr="placeholder:config.antennaPlaceholder;aria-label:config.antenna"></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="psk" aria-label="說明：PSK Reporter" data-i18n-attr="aria-label:config.help.psk">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <div class="cfg-line"><span class="cfg-label">FREE TEXT</span><input disabled placeholder="Ex: STM BVXYY/AA" aria-label="FREE TEXT"></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="freeText" aria-label="說明：FREE TEXT" data-i18n-attr="aria-label:config.help.freeText">i</button>
      </div>
    </section>

    <!-- 5 SOTA / POTA 出勤 -->
    <section id="cfg-page-activation" class="cfg-page" data-page="activation" aria-label="SOTA / POTA 出勤" data-i18n-attr="aria-label:config.section.activation" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.activationMode">出勤模式（將編號寫入記錄）</span><input type="checkbox" role="switch" disabled></label>
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.mySota">我的 SOTA</span><input disabled aria-label="我的 SOTA" data-i18n-attr="aria-label:config.mySota"></div>
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.myPota">我的 POTA</span><input disabled aria-label="我的 POTA" data-i18n-attr="aria-label:config.myPota"></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="activation" aria-label="說明：出勤活動" data-i18n-attr="aria-label:config.help.activation">i</button>
      </div>
    </section>

    <!-- 6 顯示與佈景 -->
    <section id="cfg-page-display" class="cfg-page" data-page="display" aria-label="顯示與佈景" data-i18n-attr="aria-label:config.section.display" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <!-- 語言（使用者 2026-10-07）：卡片標題固定雙語「語言／Language」、選項標籤固定用該語言自己的名稱（選錯語言也找得到）；改了會存設定並重新載入頁面（i18n/index.mjs setLanguage） -->
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-language" class="cfg-label" data-i18n-skip>語言／Language</label>
            <select id="cfg-language" class="cfg-auto">
              <option value="auto" data-i18n="config.languageAuto">自動（依瀏覽器）</option>
              <option value="en" lang="en" data-i18n-skip>English</option>
              <option value="zh-TW" lang="zh-Hant" data-i18n-skip>繁體中文</option>
            </select>
          </div>
        </div>
        <button type="button" class="info" data-help="language" aria-label="說明：語言" data-i18n-attr="aria-label:config.help.language">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <fieldset class="cfg-line">
            <legend class="cfg-label" data-i18n="config.label.theme">佈景模式</legend>
            <label><input type="radio" name="cfg-theme" value="auto" data-cfg="theme"> <span data-i18n="config.themeAuto">裝置設定</span></label>
            <label><input type="radio" name="cfg-theme" value="light" data-cfg="theme"> <span data-i18n="config.themeLight">淺色</span></label>
            <label><input type="radio" name="cfg-theme" value="dark" data-cfg="theme"> <span data-i18n="config.themeDark">深色</span></label>
          </fieldset>
        </div>
        <button type="button" class="info" data-help="theme" aria-label="說明：佈景模式" data-i18n-attr="aria-label:config.help.theme">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <fieldset class="cfg-line">
            <legend class="cfg-label" data-i18n="config.msgMode">顯示模式</legend>
            <label><input type="radio" name="cfg-msg-mode" disabled checked> <span data-i18n="config.msgModeStandard">標準</span></label>
            <label><input type="radio" name="cfg-msg-mode" disabled> <span data-i18n="config.msgModeSimple">簡要</span></label>
          </fieldset>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="messageMode" aria-label="說明：顯示模式" data-i18n-attr="aria-label:config.help.messageMode">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line">
            <label for="cfg-font-size" class="cfg-label" data-i18n="config.label.fontSize">列表字型大小</label>
            <select id="cfg-font-size" class="cfg-auto" data-cfg="fontSize">
            </select>
          </div>
        </div>
        <button type="button" class="info" data-help="fontSize" aria-label="說明：列表字型大小" data-i18n-attr="aria-label:config.help.fontSize">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.modernCallingLabel">呼叫畫面使用電台卡（摩登）</span><input id="cfg-modern-calling" type="checkbox" role="switch" data-cfg="modernCalling"></label>
        </div>
        <button type="button" class="info" data-help="modernCalling" aria-label="說明：呼叫畫面使用電台卡" data-i18n-attr="aria-label:config.help.modernCalling">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.keepScreenOnLabel">接收中保持螢幕開啟</span><input id="cfg-keep-screen-on" type="checkbox" role="switch" data-cfg="keepScreenOn"></label>
          <small class="hint" data-i18n="config.keepScreenOnHint">防止螢幕自動熄滅，手機自動鎖定時收訊才不會中斷；關掉可省電。自己按電源鍵仍會鎖定。</small>
        </div>
        <button type="button" class="info" data-help="keepScreenOn" aria-label="說明：接收中保持螢幕開啟" data-i18n-attr="aria-label:config.help.keepScreenOn">i</button>
      </div>
      <!-- 線上地圖來源（add-map-tile-source S10）：地圖種類選線上衛星影像時用哪個圖磚來源；存 ft8tw.config（全域，不隨設定組）。邏輯在 config/ui.mjs -->
      <div class="cfg-card" id="cfg-tile-card">
        <div class="cfg-body">
          <fieldset class="cfg-line cfg-tile-source">
            <legend class="cfg-label" data-i18n="config.tileSource">線上地圖來源</legend>
            <label><input type="radio" name="cfg-tile-source" value="eox2025"> <span data-i18n="config.tileEox2025">EOX Sentinel-2 cloudless 2025（預設）</span></label>
            <label><input type="radio" name="cfg-tile-source" value="eox2024"> <span data-i18n="config.tileEox2024">EOX Sentinel-2 cloudless 2024</span></label>
            <span class="cfg-break" aria-hidden="true"></span><label><input type="radio" name="cfg-tile-source" value="custom"> <span data-i18n="config.tileCustom">自訂</span></label>
          </fieldset>
          <small class="hint" data-i18n="config.tileHint">地圖種類選「衛星影像（Sentinel-2，線上）」時使用。兩個 EOX 來源都是非商業使用免費（CC BY-NC-SA 4.0）。</small>
          <div id="cfg-tile-custom" class="cfg-tile-custom" hidden>
            <div class="cfg-line">
              <label for="cfg-tile-url" class="cfg-label" data-i18n="config.tileUrl">圖磚網址樣板</label>
              <input id="cfg-tile-url" type="url" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="512" placeholder="https://example.com/{z}/{x}/{y}.png" aria-describedby="cfg-tile-url-error cfg-tile-custom-hint">
            </div>
            <small class="error" id="cfg-tile-url-error" role="alert"></small>
            <div class="cfg-line">
              <label for="cfg-tile-attribution" class="cfg-label" data-i18n="config.tileAttribution">出處標示（一行，可不填）</label>
              <input id="cfg-tile-attribution" type="text" autocomplete="off" spellcheck="false" maxlength="200" aria-describedby="cfg-tile-attribution-error">
            </div>
            <small class="error" id="cfg-tile-attribution-error" role="alert"></small>
            <div class="cfg-line">
              <button type="button" id="cfg-tile-apply" class="secondary" data-i18n="config.tileApply">套用</button>
              <small class="hint" id="cfg-tile-msg" aria-live="polite"></small>
            </div>
            <small class="hint" id="cfg-tile-custom-hint" data-i18n="config.tileCustomHint">只支援 Web Mercator（EPSG:3857）XYZ、256 px 圖磚，例如 https://example.com/{z}/{x}/{y}.png；伺服器須允許跨來源請求（CORS）。圖磚的使用條款由使用者自行負責。瀏覽器會直接連到該網站。</small>
          </div>
        </div>
        <button type="button" class="info" data-help="mapTileSource" aria-label="說明：線上地圖來源" data-i18n-attr="aria-label:config.help.mapTileSource">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.freqLine">頻率標示線</span><select disabled aria-label="頻率標示線" data-i18n-attr="aria-label:config.freqLine"><option data-i18n="config.freqLineFade">一段時間後消失</option></select></div>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.keepScreenOn">防止螢幕關閉</span><input type="checkbox" role="switch" disabled></label>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.miniWaterfall">解碼介面顯示小瀑布圖</span><input type="checkbox" role="switch" disabled></label>
          <div class="cfg-line"><span class="cfg-label" data-i18n="config.waterfallColors">瀑布圖色階</span><select disabled aria-label="瀑布圖色階" data-i18n-attr="aria-label:config.waterfallColors"><option data-i18n="config.waterfallClassic">經典（黑藍黃紅）</option></select></div>
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.qslFlash">通聯成功：畫面閃爍</span><input type="checkbox" role="switch" disabled></label>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="ui" aria-label="說明：使用者介面" data-i18n-attr="aria-label:config.help.ui">i</button>
      </div>
    </section>

    <!-- 7 備份與還原 -->
    <section id="cfg-page-backup" class="cfg-page" data-page="backup" aria-label="備份與還原" data-i18n-attr="aria-label:config.section.backup" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <label class="cfg-line switch"><span class="cfg-label" data-i18n="config.backupAuto">啟動時自動備份</span><input type="checkbox" role="switch" disabled></label>
          <div class="cfg-line">
            <button type="button" class="secondary" disabled data-i18n="config.backupNow">立即備份</button>
            <button type="button" class="secondary" disabled data-i18n="config.backupRestore">還原備份</button>
          </div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="backup" aria-label="說明：自動備份" data-i18n-attr="aria-label:config.help.backup">i</button>
      </div>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <span class="cfg-label" data-i18n="config.clearData">清空儲存資料</span>
          <div class="cfg-line">
            <button type="button" class="secondary" disabled data-i18n="config.clearFollowed">關注的呼號</button>
            <button type="button" class="secondary" disabled data-i18n="config.clearSwl">SWL 記錄</button>
            <button type="button" class="secondary" disabled data-i18n="config.clearQso">所有通聯紀錄</button>
          </div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
        <button type="button" class="info" data-help="clearData" aria-label="說明：清空儲存資料" data-i18n-attr="aria-label:config.help.clearData">i</button>
      </div>
    </section>

    <!-- 8 進階與開發者（錄音來源、權限、開發者 API 在瀏覽器沒有意義，不顯示） -->
    <section id="cfg-page-advanced" class="cfg-page" data-page="advanced" aria-label="進階與開發者" data-i18n-attr="aria-label:config.section.advanced" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card soon">
        <div class="cfg-body">
          <span class="cfg-label" data-i18n="config.audioDiag">音訊裝置與發射音訊診斷</span>
          <div class="cfg-line"><button type="button" class="secondary" disabled data-i18n="config.redetect">重新偵測</button></div>
          <span class="soon-badge" data-i18n="config.soon">即將推出</span>
        </div>
      </div>
    </section>

    <!-- SWL Log -->
    <section id="cfg-page-swllog" class="cfg-page" data-page="swllog" aria-label="SWL Log（收聽記錄）" data-i18n-attr="aria-label:config.section.swllog" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card">
        <div class="cfg-body">
          <p id="log-status" class="hint"></p>
          <p id="log-count" class="count"></p>
          <div class="cfg-line">
            <label for="log-retention" class="cfg-label" data-i18n="config.retention">保留期限</label>
            <select id="log-retention" class="cfg-auto">
              <option value="7" data-i18n="config.retention7">7 天</option>
              <option value="30" data-i18n="config.retention30">30 天</option>
              <option value="90" data-i18n="config.retention90">90 天</option>
              <option value="never" data-i18n="config.retentionNever">不刪除</option>
            </select>
          </div>
          <p id="log-usage" class="hint"></p>
        </div>
        <button type="button" class="info" data-help="retention" aria-label="說明：SWL Log" data-i18n-attr="aria-label:config.help.retention">i</button>
      </div>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="cfg-line"><label for="log-from" class="cfg-label" data-i18n="config.logFrom">起日（UTC）</label><input id="log-from" type="date"></div>
          <div class="cfg-line"><label for="log-to" class="cfg-label" data-i18n="config.logTo">迄日（UTC）</label><input id="log-to" type="date"></div>
          <div class="actions">
            <button id="log-export" type="button" class="secondary" data-i18n="config.logExport">匯出 ADIF</button>
          </div>
          <p id="log-msg" class="hint" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <!-- 更新歷程（使用者 2026-10-09）：新的在上面，每版可展開／收合；內容由 config/ui.mjs 依 js/changelog.mjs 產生 -->
    <section id="cfg-page-changelog" class="cfg-page" data-page="changelog" aria-label="更新歷程" data-i18n-attr="aria-label:config.section.changelog" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="about-brand">
            <img class="about-logo" src="assets/logo/ft8tw-logo-192.png" width="72" height="72" alt="FT8TW">
            <p><span data-i18n="config.aboutName">FT8TW 網頁接收站</span><br><span id="cfg-changelog-current" class="hint"></span></p>
          </div>
          <div class="cfg-line changelog-tools">
            <button type="button" id="cfg-changelog-expand" class="secondary" data-i18n="config.changelogExpand">全部展開</button>
            <button type="button" id="cfg-changelog-collapse" class="secondary" data-i18n="config.changelogCollapse">全部收合</button>
          </div>
          <div id="cfg-changelog" class="changelog"></div>
        </div>
      </div>
    </section>

    <!-- 關於 -->
    <section id="cfg-page-about" class="cfg-page" data-page="about" aria-label="關於" data-i18n-attr="aria-label:config.section.about" hidden>
      <button type="button" class="cfg-back" data-i18n="config.back">‹ 回主設定選單</button>
      <div class="cfg-card">
        <div class="cfg-body">
          <div class="about-brand">
            <img class="about-logo" src="assets/logo/ft8tw-logo-192.png" width="72" height="72" alt="FT8TW">
            <p><span data-i18n="config.aboutName">FT8TW 網頁接收站</span> <span id="cfg-version"></span></p>
          </div>
          <!-- 連到「更新歷程」頁（使用者 2026-10-09） -->
          <p><button type="button" id="cfg-about-changelog" class="link-button"></button></p>
          <p class="hint" data-i18n="config.aboutText">在瀏覽器裡直接解碼 FT8／FT4／JS8／FT2，經 FT8TW 轉送站回報 PSKReporter。FT8TW 是 BG7YOZ 所開發 FT8CN 的分支，感謝原作者。</p>
          <p class="hint" data-i18n="config.privacyUsage">轉送站會記錄 IP 位址、連線來源國家（由 Cloudflare 提供）、呼號（有填時）、每天的使用時間與使用起訖時間，以及回報筆數，保留 90 天，只供管理者統計；不記錄精確位置。</p>
          <p class="hint" data-i18n="config.privacyEox">地圖選擇「衛星影像（Sentinel-2，線上）」時，瀏覽器會直接向 EOX（奧地利）下載圖磚，EOX 會看到你的 IP 與查看的地圖範圍；其他底圖不連外。若在「設置 › 顯示與佈景」設了自訂線上地圖來源，瀏覽器會改為直接連到該網站。</p>
          <!-- 與 FT8TW App「關於」相同的連結（使用者 2026-10-07，取自 App assets/readme_tw.txt） -->
          <ul class="links">
            <li><a href="https://www.facebook.com/groups/2460163917688075" target="_blank" rel="noopener" data-i18n="config.aboutFacebook">Facebook 社團</a></li>
            <li><a id="cfg-about-issues" href="https://github.com/danleetw/FT8TW/issues" target="_blank" rel="noopener" data-i18n="config.aboutIssues">回報問題</a></li>
            <li><a href="https://play.google.com/store/apps/details?id=com.bv6lc.ft8tw" target="_blank" rel="noopener" data-i18n="config.aboutPlay">從 Google Play 下載</a></li>
            <li><a href="https://github.com/danleetw/FT8TW" target="_blank" rel="noopener" data-i18n="config.aboutGithub">從 GitHub 下載</a></li>
            <li><a href="https://danleetw.github.io/FT8TW/" target="_blank" rel="noopener" data-i18n="config.aboutManual">使用者手冊</a></li>
            <li><a href="https://www.youtube.com/playlist?list=PLrXZ1U6SCKfWc8pYtKHpirGeyk5XCOdfp" target="_blank" rel="noopener" data-i18n="config.aboutYoutube">YouTube 播放清單</a></li>
          </ul>
          <p class="hint" data-i18n="config.supportText">支持 FT8TW 開發：FT8TW 免費，而且會一直免費。如果它對你有幫助，一杯咖啡或一頓午餐可以幫忙負擔 QRZ.com 訂閱費與開發用的設備。贊助完全出於自願，不會解鎖任何功能。</p>
          <ul class="links">
            <li><a href="https://ko-fi.com/bv6lc" target="_blank" rel="noopener" data-i18n="config.aboutKofi">請我喝杯咖啡（Ko-fi）</a></li>
          </ul>
          <ul class="links">
            <!-- 原始碼不公開（使用者 2026-10-07）；第三方授權聲明放在網站上（web/NOTICE.txt，與 repo 根目錄 NOTICE 相同，webtest 檢查） -->
            <li><a href="NOTICE.txt" target="_blank" rel="noopener" data-i18n="config.notice">NOTICE：第三方元件與授權</a></li>
          </ul>
        </div>
      </div>
    </section>
  </aside>

  <main class="layout" tabindex="-1">
    <div class="side">

    <!-- 頻譜／瀑布圖（add-web-transmit D21）：可獨立放置的區塊，畫布大小隨容器（spectrum/waterfall.mjs） -->
    <!-- 不放標題（使用者 2026-10-06）；提示只在滑鼠停在頻譜上時出現；右鍵（手機長按）開「瀑布圖顯示調整」 -->
    <section id="spectrum-panel" class="panel spectrum" aria-label="頻譜與瀑布圖" data-i18n-attr="aria-label:page.spectrum.label">
      <!-- 收折鈕（使用者 2026-10-07：可以收折；不要文字占空間，放白框左上角內距裡；web/js/sidelayout.mjs） -->
      <button id="spectrum-toggle" type="button" class="panel-fold" aria-expanded="true" title="收起／展開頻譜" aria-label="收起／展開頻譜" data-i18n-attr="title:page.side.spectrum;aria-label:page.side.spectrum"><span class="chev" aria-hidden="true"><svg viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,3.5 5,6.5 8,3.5"/></svg></span><span class="fold-label" aria-hidden="true" data-i18n="page.side.spectrum_name">頻譜／瀑布圖</span></button>
      <div class="spectrum-view">
        <canvas id="spectrum-canvas" role="img" aria-label="頻譜與瀑布圖：點一下設定發射聲音頻率，按右鍵（手機長按）調整顯示" data-i18n-attr="aria-label:page.spectrum.canvas"></canvas>
        <span class="spectrum-hint" aria-hidden="true" data-i18n="page.spectrum.hint">點一下設定發射聲音頻率 · 右鍵調整顯示</span>
      </div>
      <!-- JTTY 字幕區（使用者 2026-10-09）：瀑布圖下方，每台一條跑馬燈（web/js/jtty/ticker-ui.mjs）；只在 JTTY 顯示。
           aria-live="off"：文字一個字一個字出現，不要讓螢幕閱讀器一直唸（通訊畫面的泡泡有完整內容） -->
      <div id="jtty-ticker" class="jtty-ticker" role="marquee" aria-live="off" aria-label="JTTY 字幕：各台收到的文字" data-i18n-attr="aria-label:spectrum.ticker"></div>
      <dialog id="spectrum-adjust" class="spectrum-adjust" aria-labelledby="spectrum-adjust-title">
        <h3 id="spectrum-adjust-title" data-i18n="page.spectrum.adjust_title">瀑布圖顯示調整</h3>
        <label for="spectrum-zero" id="spectrum-zero-label" data-i18n="page.spectrum.zero">基準（黑色位準）</label>
        <input id="spectrum-zero" type="range" min="-20" max="20" step="1" value="0">
        <p class="hint" data-i18n="page.spectrum.zero_hint">往右：把更多背景雜訊壓成黑色</p>
        <label for="spectrum-gain" id="spectrum-gain-label" data-i18n="page.spectrum.gain">對比</label>
        <input id="spectrum-gain" type="range" min="-20" max="20" step="1" value="0">
        <p class="hint" data-i18n="page.spectrum.gain_hint">往右：強弱訊號的對比更明顯</p>
        <label class="check"><input id="spectrum-mark" type="checkbox" role="switch" checked> <span data-i18n="page.spectrum.mark">標記訊息</span></label>
        <div class="spectrum-adjust-actions">
          <button id="spectrum-auto" type="button" class="secondary" data-i18n="common.auto">自動</button>
          <button id="spectrum-adjust-close" type="button" data-i18n="common.close">關閉</button>
        </div>
      </dialog>
    </section>

    <!-- 地圖（使用者 2026-10-06，仿 FT8TW 呼叫面板小地圖）：最近 N 分鐘聽到的電台；尺寸隨容器（web/js/map/） -->
    <!-- 地圖（使用者 2026-10-07）：只畫右邊目前所選清單（解碼／呼叫／電台卡）裡的電台，沒有自己的篩選與標題；
         沒網格的用呼號的國家中心點（虛線圈）。「全覽」浮在地圖右上角 -->
    <div id="side-split" class="side-split" role="separator" aria-orientation="horizontal" aria-valuemin="15" aria-valuemax="85" tabindex="0" title="拖曳調整頻譜與地圖的高度（雙擊恢復）" aria-label="調整頻譜與地圖的高度" data-i18n-attr="title:page.side.split_title;aria-label:page.side.split"></div>
    <section id="map-panel" class="panel map" aria-label="右邊清單裡電台的地圖" data-i18n-attr="aria-label:mapui.region">
      <button id="map-back" type="button" class="p-back" data-icon="back" aria-label="返回" data-i18n-attr="aria-label:page.back"></button>
      <button id="map-toggle" type="button" class="panel-fold" aria-expanded="true" title="收起／展開地圖" aria-label="收起／展開地圖" data-i18n-attr="title:page.side.map;aria-label:page.side.map"><span class="chev" aria-hidden="true"><svg viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,3.5 5,6.5 8,3.5"/></svg></span><span class="fold-label" aria-hidden="true" data-i18n="page.side.map_name">地圖</span></button>
      <div class="map-wrap">
        <canvas id="map-canvas" role="img" aria-label="目前清單裡電台的位置地圖" data-i18n-attr="aria-label:mapui.canvas"></canvas>
        <p id="map-notice" class="map-notice" role="status" hidden></p>
        <!-- EOX 規定的標示（CC BY-NC-SA 4.0，原文照用、不翻譯）：選線上衛星底圖時才顯示（panel.mjs） -->
        <p id="map-attribution" class="map-attribution" hidden translate="no">EOxCloudless <a href="https://cloudless.eox.at" target="_blank" rel="noopener">https://cloudless.eox.at</a> by EOX IT Services GmbH (Contains modified Copernicus Sentinel data 2025)</p>
        <div class="map-tools">
          <!-- 地圖設定（add-map-settings-globe）：也可在地圖上按右鍵（手機長按）；圖示由 panel.mjs 放入 -->
          <button id="map-settings-btn" type="button" class="secondary map-fit map-gear" title="地圖設定（也可在地圖上按右鍵）" aria-label="地圖設定" data-i18n-attr="title:mapui.settingsTitle;aria-label:mapui.settings"></button>
          <button id="map-links" type="button" class="secondary map-fit" aria-pressed="true" title="畫出誰呼叫誰（最近兩個 slot）" data-i18n-attr="title:mapui.linksTitle"><span data-i18n="mapui.links">連線</span></button>
          <button id="map-fit" type="button" class="secondary map-fit" title="框住全部電台" data-i18n-attr="title:mapui.fitTitle"><span data-i18n="mapui.fit">全覽</span></button>
        </div>
      </div>
      <p class="hint map-legend"><span class="dot cq"></span><span data-i18n="mapui.cq">CQ</span> <span class="dot callme"></span><span data-i18n="mapui.callMe">叫我</span> <span class="dot target"></span><span data-i18n="mapui.target">目前對象</span> <span class="dot other"></span><span data-i18n="mapui.other">其他</span> <span class="dot mine"></span><span data-i18n="mapui.me">我</span> <span class="dot selected"></span><span data-i18n="mapui.selected">已選取</span></p>
      <!-- 地圖設定框（add-map-settings-globe D3）：改了立即套用並保存；點背景關閉 -->
      <dialog id="map-settings" class="map-settings" aria-labelledby="map-settings-title">
        <h3 id="map-settings-title" data-i18n="mapui.settings">地圖設定</h3>
        <fieldset>
          <legend data-i18n="mapui.type">地圖種類</legend>
          <label class="check"><input type="radio" name="map-type" value="outline"> <span data-i18n="mapui.typeOutline">簡圖</span></label>
          <label class="check"><input type="radio" name="map-type" value="satellite"> <span data-i18n="mapui.typeSatellite">衛星影像</span></label>
          <label class="check"><input type="radio" name="map-type" value="relief"> <span data-i18n="mapui.typeRelief">地形淡色</span></label>
          <!-- EOX Sentinel-2 cloudless 線上圖磚（add-map-eox-imagery）：選了才連 tiles.maps.eox.at -->
          <label class="check"><input type="radio" name="map-type" value="eox"> <span id="map-type-eox-label" data-i18n="mapui.typeEox">衛星影像（Sentinel-2，線上）</span></label>
        </fieldset>
        <fieldset>
          <legend data-i18n="mapui.layers">顯示</legend>
          <label class="check"><input id="map-borders" type="checkbox" role="switch"> <span data-i18n="mapui.borders">國界</span></label>
          <label class="check"><input id="map-names" type="checkbox" role="switch"> <span data-i18n="mapui.names">國名</span></label>
          <label class="check"><input id="map-daynight" type="checkbox" role="switch"> <span data-i18n="mapui.daynight">日夜分界線</span></label>
          <!-- 圖層（add-map-overlays）：第一次打開才下載資料 -->
          <label class="check"><input id="map-grid" type="checkbox" role="switch"> <span data-i18n="mapui.grid">Grid（梅登黑德方格）</span></label>
          <label class="check"><input id="map-cqzones" type="checkbox" role="switch"> <span data-i18n="mapui.cqZones">CQ Zone</span></label>
          <label class="check"><input id="map-ituzones" type="checkbox" role="switch"> <span data-i18n="mapui.ituZones">ITU Zone</span></label>
          <label class="check"><input id="map-states" type="checkbox" role="switch"> <span data-i18n="mapui.states">州界（一級行政區）</span></label>
        </fieldset>
        <fieldset>
          <legend data-i18n="mapui.view">平面／立體</legend>
          <label class="check"><input type="radio" name="map-view" value="2d"> <span data-i18n="mapui.view2d">2D 平面地圖</span></label>
          <label class="check"><input type="radio" name="map-view" value="3d"> <span data-i18n="mapui.view3d">3D 地球</span></label>
        </fieldset>
        <p id="map-settings-note" class="hint error" aria-live="polite"></p>
        <p class="hint map-credit" data-i18n="mapui.credit">影像：NASA Blue Marble；線上衛星影像：EOxCloudless by EOX IT Services GmbH（含修改過的 Copernicus Sentinel 2025 資料，CC BY-NC-SA 4.0）；地形、國界、州界、國名：Natural Earth；CQ／ITU Zone：HB9HIL（MIT）</p>
        <div class="map-settings-actions">
          <button id="map-settings-close" type="button" data-i18n="common.close">關閉</button>
        </div>
      </dialog>
    </section>
    </div>

    <div id="col-split" class="col-split" role="separator" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" tabindex="0" title="拖曳調整左右欄的寬度（雙擊恢復）" aria-label="調整左右欄的寬度" data-i18n-attr="title:page.side.colsplit_title;aria-label:page.side.colsplit"></div>

    <div class="lists">
    <div id="list-tabs" class="list-tabs" role="tablist" aria-label="列表" data-i18n-attr="aria-label:page.list_tabs"></div>
    <!-- JS8 通訊畫面（add-web-js8-chat D1，仿 FT8TW Js8Fragment）：只在 JS8 模式出現（body.mode-js8） -->
    <section id="js8-chat-panel" class="panel js8chat" aria-label="JS8 通訊" data-i18n-attr="aria-label:js8chat.region">
      <div class="js8c-row js8c-top">
        <button id="js8-back" type="button" class="p-back" data-icon="back" aria-label="返回" data-i18n-attr="aria-label:page.back"></button>
        <span id="js8c-status" class="js8c-status" aria-live="polite" data-i18n="js8chat.status.idle">JS8 待機</span>
        <span id="js8c-countdown" class="js8c-countdown" title="距下一時槽" data-i18n-attr="title:js8chat.next_slot"></span>
        <span id="js8c-dial" class="js8c-dial"></span>
      </div>
      <div class="js8c-row js8c-pickers">
        <select id="js8c-station" class="js8c-station" aria-label="對象電台" data-i18n-attr="aria-label:js8chat.station"></select>
        <select id="js8c-speed" class="js8c-speed" aria-label="發送速度" data-i18n-attr="aria-label:js8chat.speed"></select>
        <button id="js8c-fun" type="button" class="secondary" aria-haspopup="dialog" data-i18n="js8chat.fun">FUN</button>
      </div>
      <ol id="js8c-list" class="js8c-list" role="log" aria-live="polite" aria-label="對話" data-i18n-attr="aria-label:js8chat.list"></ol>
      <p id="js8c-empty" class="hint js8c-empty" data-i18n="js8chat.empty">還沒有 JS8 對話。收到的訊息、送出的訊息都會出現在這裡。</p>
      <div class="js8c-row js8c-bar">
        <span id="js8c-rxstatus" class="js8c-rxstatus" aria-live="polite"></span>
        <span id="js8c-frames" class="js8c-frames"></span>
      </div>
      <div class="js8c-row js8c-input">
        <button id="js8c-quick" type="button" class="secondary" aria-haspopup="menu" data-i18n="js8chat.quick.button">常用訊息</button>
        <textarea id="js8c-text" rows="1" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="訊息內容，例如 CQ CQ CQ PL05 或 對方呼號 HELLO" aria-label="訊息" data-i18n-attr="placeholder:js8chat.input_hint;aria-label:js8chat.input"></textarea>
        <button id="js8c-send" type="button" class="danger" data-i18n="js8chat.send">送出</button>
      </div>
      <div class="js8c-row js8c-settings">
        <label class="js8c-freq"><span data-i18n="js8chat.audio_freq">發射音頻 (Hz)</span> <input id="js8c-freq" type="number" min="500" max="2500" step="10" inputmode="numeric"></label>
        <label class="check" title="右鍵（手機長按）設定" data-i18n-attr="title:js8chat.autoreply_title"><input id="js8c-autoreply" type="checkbox" role="switch"> <span data-i18n="js8chat.autoreply">自動回覆</span></label>
        <label class="js8c-hb"><span data-i18n="js8chat.hb">HB</span>
          <select id="js8c-hb"><option value="0" data-i18n="js8chat.hb_off">關</option><option value="10">10m</option><option value="15">15m</option><option value="30">30m</option></select></label>
        <button id="js8c-hb-now" type="button" class="secondary" data-i18n="js8chat.hb_now">立即發送HB</button>
      </div>
      <div id="js8c-menu" class="js8c-menu" role="menu" hidden></div>
      <dialog id="js8c-fun-dialog" class="js8c-dialog" aria-labelledby="js8c-fun-title">
        <h3 id="js8c-fun-title" data-i18n="js8chat.fun_title">功能</h3>
        <label class="check"><input id="js8c-multispeed" type="checkbox" role="switch"> <span data-i18n="js8chat.multi_speed">同時解碼其他速度</span></label>
        <label class="check"><input id="js8c-utx" type="checkbox" role="switch"> <span data-i18n="js8chat.force_utx">強化編碼</span> <small class="hint" data-i18n="js8chat.utx_hint">中文、大小寫混雜時使用；只有 FT8TW 解得開</small></label>
        <label class="check" title="右鍵（手機長按）設定 passcode" data-i18n-attr="title:js8chat.igate_title"><input id="js8c-igate" type="checkbox" role="switch"> <span data-i18n="js8chat.igate">APRS-IS iGate（轉發 @APRSIS）</span></label>
        <button id="js8c-igate-settings" type="button" class="secondary" data-i18n="js8chat.igate_settings">iGate 設定</button>
        <label class="check"><input id="js8c-local" type="checkbox" role="switch"> <span data-i18n="js8chat.local_time">顯示本地時間（關＝UTC）</span></label>
        <label class="field"><span data-i18n="js8chat.sort_title">電台排序</span>
          <select id="js8c-sort"><option value="call" data-i18n="js8chat.sort_call">呼號</option><option value="snr" data-i18n="js8chat.sort_snr">訊號強度</option><option value="recent" data-i18n="js8chat.sort_recent">最近收到</option></select></label>
        <div class="js8c-dialog-actions">
          <button id="js8c-clear-all" type="button" class="secondary danger-text" data-i18n="js8chat.clear_all">刪除所有通話紀錄</button>
          <button id="js8c-fun-close" type="button" data-i18n="common.close">關閉</button>
        </div>
      </dialog>
      <dialog id="js8c-aprs-dialog" class="js8c-dialog" aria-labelledby="js8c-aprs-title">
        <h3 id="js8c-aprs-title" data-i18n="js8chat.quick.aprsMessage">發送 APRS 訊息（@APRSIS）</h3>
        <label class="field"><span data-i18n="js8chat.aprs.to">收件人呼號（例：BV6LC-9）</span><input id="js8c-aprs-to" maxlength="9" autocapitalize="characters" spellcheck="false" autocomplete="off"></label>
        <label class="field"><span data-i18n="js8chat.aprs.text">訊息（最多 67 字元）</span><input id="js8c-aprs-text" maxlength="67" autocapitalize="characters" spellcheck="false" autocomplete="off"></label>
        <p class="hint" data-i18n="js8chat.aprs.note">只能用英文字母、數字、空白與 . - + ? ! /。對方的回覆無法回到 JS8（只能單向送上 APRS-IS）。</p>
        <p id="js8c-aprs-error" class="hint error" aria-live="polite"></p>
        <div class="js8c-dialog-actions">
          <button id="js8c-aprs-cancel" type="button" class="secondary" data-i18n="common.cancel">取消</button>
          <button id="js8c-aprs-ok" type="button" data-i18n="js8chat.aprs.fill">填入訊息</button>
        </div>
      </dialog>
      <!-- APRS-IS iGate 設定（add-web-js8-chat J4、design D17、D22）：用自己的呼號＋passcode 登入；passcode 只存這個瀏覽器、轉送站只放記憶體 -->
      <dialog id="js8c-igate-dialog" class="js8c-dialog" aria-labelledby="js8c-igate-title">
        <h3 id="js8c-igate-title" data-i18n="js8chat.igate_settings">iGate 設定</h3>
        <p class="hint" data-i18n="js8chat.igate_explain">把收到的 @APRSIS 位置與訊息轉進 APRS-IS，以你自己的呼號登入。只在 JS8 畫面開著時運作。</p>
        <label class="field"><span data-i18n="js8chat.igate_passcode">APRS-IS passcode（必填）</span><input id="js8c-igate-pass" type="password" inputmode="numeric" autocomplete="off" maxlength="5"></label>
        <p id="js8c-igate-warn" class="hint error" aria-live="polite"></p>
        <p id="js8c-igate-state" class="hint" aria-live="polite"></p>
        <!-- 登入檢查（design D23）：只登入、不送封包；正式站（真 APRS-IS）唯一的確認方法 -->
        <p class="js8c-igate-verify-row"><button id="js8c-igate-verify" type="button" class="secondary" data-i18n="js8chat.igate_verify">檢查登入</button>
          <span id="js8c-igate-verify-result" class="hint" aria-live="polite"></span></p>
        <p id="js8c-igate-test-hint" class="hint" data-i18n="js8chat.igate_test_disabled" hidden>正式站連的是真的 APRS-IS，不提供測試封包；請用「檢查登入」</p>
        <div class="js8c-dialog-actions">
          <button id="js8c-igate-clear" type="button" class="secondary" data-i18n="js8chat.igate_clear">清除 passcode</button>
          <button id="js8c-igate-test" type="button" class="secondary" data-i18n="js8chat.igate_test">送出測試封包</button>
          <button id="js8c-igate-close" type="button" data-i18n="common.close">關閉</button>
        </div>
      </dialog>
      <dialog id="js8c-auto-dialog" class="js8c-dialog" aria-labelledby="js8c-auto-title">
        <h3 id="js8c-auto-title" data-i18n="js8chat.auto_title">自動回覆設定</h3>
        <label class="check"><input id="js8c-auto-cq" type="checkbox" role="switch"> <span data-i18n="js8chat.auto_cq">收到 CQ 自動回覆 SNR</span></label>
        <label class="check"><input id="js8c-auto-hb" type="checkbox" role="switch"> <span data-i18n="js8chat.auto_hb">收到 HB 自動回覆 HEARTBEAT SNR</span></label>
        <label class="field"><span data-i18n="js8chat.hb_per_hour">每小時最多自動 ACK 次數</span>
          <select id="js8c-hb-hour"><option>2</option><option>4</option><option>6</option><option>10</option><option>20</option></select></label>
        <label class="field"><span data-i18n="js8chat.hb_per_call">同一呼號 10 分鐘內最多次數</span>
          <select id="js8c-hb-call"><option>1</option><option>2</option><option>3</option></select></label>
        <label class="field"><span data-i18n="js8chat.info_field">INFO? 回覆內容</span><input id="js8c-info" maxlength="40" autocapitalize="characters" spellcheck="false"></label>
        <label class="field"><span data-i18n="js8chat.status_field">STATUS? 回覆內容</span><input id="js8c-status-text" maxlength="40" autocapitalize="characters" spellcheck="false"></label>
        <div class="js8c-dialog-actions"><button id="js8c-auto-close" type="button" data-i18n="common.close">關閉</button></div>
      </dialog>
    </section>
    <!-- JTTY 通訊畫面（add-web-jtty D10～D12）：只在 JTTY 模式出現（body.mode-jtty）；版面同 JS8（body.mode-chat），泡泡沿用 js8c-* -->
    <section id="jtty-chat-panel" class="panel js8chat jttychat" aria-label="JTTY 通訊" data-i18n-attr="aria-label:jtty.region">
      <div class="js8c-row js8c-top">
        <button id="jtty-back" type="button" class="p-back" data-icon="back" aria-label="返回" data-i18n-attr="aria-label:page.back"></button>
        <span id="jtty-status" class="js8c-status" aria-live="polite" data-i18n="jtty.status.idle">JTTY 待機</span>
        <span id="jtty-dropped" class="js8c-countdown"></span>
        <span id="jtty-dial" class="js8c-dial"></span>
      </div>
      <div class="js8c-row js8c-pickers">
        <select id="jtty-station" class="js8c-station" aria-label="對象電台" data-i18n-attr="aria-label:jtty.station"></select>
      </div>
      <ol id="jtty-list" class="js8c-list" role="log" aria-live="polite" aria-label="對話" data-i18n-attr="aria-label:jtty.list"></ol>
      <p id="jtty-empty" class="hint js8c-empty" data-i18n="jtty.empty">還沒有 JTTY 對話。收到的訊息、送出的訊息都會出現在這裡；點收到的訊息可帶入對方呼號。</p>
      <div class="js8c-row jtty-fields">
        <label class="jtty-field"><span data-i18n="jtty.his">對方</span><input id="jtty-his" maxlength="11" autocomplete="off" autocapitalize="characters" spellcheck="false"></label>
        <label class="jtty-field"><span data-i18n="jtty.queued">排隊</span><input id="jtty-queued" maxlength="11" autocomplete="off" autocapitalize="characters" spellcheck="false"></label>
        <span class="jtty-field jtty-serial"><label for="jtty-serial" data-i18n="jtty.serial">序號</label>
          <button id="jtty-serial-dec" type="button" class="secondary" aria-label="序號減 1" data-i18n-attr="aria-label:jtty.serial_dec">−</button><input id="jtty-serial" type="number" step="1" inputmode="numeric"><button id="jtty-serial-inc" type="button" class="secondary" aria-label="序號加 1" data-i18n-attr="aria-label:jtty.serial_inc">+</button></span>
      </div>
      <div id="jtty-fkeys" class="jtty-fkeys" role="group" aria-label="巨集 1～8" data-i18n-attr="aria-label:jtty.fkeys"></div>
      <div class="js8c-row js8c-bar jtty-bar">
        <label class="check jtty-utx" title="強化編碼（UTX）：可送中文、小寫、emoji 等任何文字，只有 FT8TW 解得開；純大寫英數照 JTTY 原樣送" data-i18n-attr="title:jtty.utx_title"><input id="jtty-utx" type="checkbox" role="switch"> <span data-i18n="jtty.utx">強化</span></label>
        <span id="jtty-preview" class="js8c-frames" aria-live="polite"></span>
      </div>
      <div class="js8c-row js8c-input">
        <button id="jtty-macro-edit" type="button" class="secondary" aria-haspopup="dialog" data-i18n="jtty.macros">巨集</button>
        <textarea id="jtty-text" rows="1" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="訊息，例如 CQ BV6LC CQ" aria-label="訊息" aria-describedby="jtty-warn" data-i18n-attr="placeholder:jtty.input_hint;aria-label:jtty.input"></textarea>
        <button id="jtty-send" type="button" class="danger" data-i18n="jtty.send">送出</button>
      </div>
      <p id="jtty-warn" class="hint error jtty-warn" aria-live="polite"></p>
      <dialog id="jtty-macro-dialog" class="js8c-dialog" aria-labelledby="jtty-macro-title">
        <h3 id="jtty-macro-title" data-i18n="jtty.macro_title">巨集 1～8</h3>
        <p class="hint" data-i18n="jtty.macro_hint">%M＝我的呼號、%H＝對方、%E＝599 序號、%Q＝排隊呼號</p>
        <div id="jtty-macro-fields"></div>
        <label class="check jtty-attach"><input id="jtty-attach-call" type="checkbox" role="switch"> <span data-i18n="jtty.attach_call">附帶我的呼號（只 FT8TW 看得到）</span></label>
        <p class="hint" data-i18n="jtty.attach_call_hint">每次發射開頭多一個 frame（1.9 秒），讓其他 FT8TW 使用者知道是誰在發；訊息已寫 CQ &lt;我的呼號&gt; CQ 或 DE &lt;我的呼號&gt; 時不加。WSJT-X 會忽略</p>
        <label class="jtty-rest"><span data-i18n="jtty.rest_frames">多則之間休息（frame）</span> <input id="jtty-rest" type="number" min="1" max="16" step="1" inputmode="numeric"> <span id="jtty-rest-sec" class="hint"></span></label>
        <p class="hint" data-i18n="jtty.rest_hint">訊息超過 16 frame 會自動分成多則送出，每則之間放開 PTT 休息，避免長時間發射電台過熱。1～16 frame，預設 4（約 7.6 秒）</p>
        <label class="jtty-fec"><span data-i18n="jtty.fec">糾錯</span> <select id="jtty-fec">
          <option value="off" data-i18n="jtty.fec_off">關</option>
          <option value="standard" data-i18n="jtty.fec_standard">標準（多 2 frame，可補回 1 個漏掉的）</option>
          <option value="strong" data-i18n="jtty.fec_strong">加強（多 4 frame，可補回 2 個漏掉的）</option>
        </select></label>
        <p class="hint" data-i18n="jtty.fec_hint">3 frame 以上的訊息在結尾後多送幾個校驗 frame，其他 FT8TW 漏收的 frame 可以算回來。WSJT-X 會忽略，只多佔發射時間</p>
        <div class="js8c-dialog-actions">
          <button id="jtty-macro-reset" type="button" class="secondary" data-i18n="jtty.macro_reset">還原預設</button>
          <button id="jtty-macro-cancel" type="button" class="secondary" data-i18n="common.cancel">取消</button>
          <button id="jtty-macro-save" type="button" data-i18n="jtty.macro_save">儲存</button>
        </div>
      </dialog>
    </section>
    <section id="decodes-panel" class="panel feed">
      <h2><span data-i18n="page.tab.decode">解碼</span> <span id="count" class="count"></span>
        <button id="decodes-clear" type="button" class="icon clear-btn" aria-label="清除解碼清單" title="清除解碼清單" data-i18n-attr="aria-label:page.decode.clear;title:page.decode.clear">✕</button></h2>
      <!-- 時間、類別篩選（使用者 2026-10-09，cards/ui.mjs 產生）：只在 FT8／FT4／FT2 顯示 -->
      <div id="decode-filters" class="seg list-filters" role="group" aria-label="解碼清單篩選" data-i18n-attr="aria-label:cards.decodeFilters"></div>
      <div class="table-wrap cards-wrap">
        <!-- 明確的 role：手機版把列改成 grid 卡片後，瀏覽器會丟掉表格語意，報讀軟體就讀不到欄名 -->
        <table role="table">
          <thead role="rowgroup">
            <tr role="row"><th role="columnheader" class="utc">UTC</th><th role="columnheader" class="seq">S.</th><th role="columnheader" class="num snr">dB</th><th role="columnheader" class="num dt">Δt</th><th role="columnheader" class="num hz" data-i18n="page.col.hz">頻率</th><th role="columnheader" class="msg"><span data-i18n="page.col.msg">訊息</span><span class="colhead-n"></span></th><th role="columnheader" class="num dist" data-i18n="page.col.dist">距離</th><th role="columnheader" class="from" data-i18n="page.col.from">發話方</th><th role="columnheader" class="to" data-i18n="page.col.to">接收方</th></tr>
          </thead>
          <tbody id="decodes" role="rowgroup"></tbody>
        </table>
      </div>
    </section>

    <!-- 呼叫清單（呼叫頁中段，add-web-transmit 3.4／3.5）：版面位置由主線決定；設置開啟「電台卡（摩登）」時改顯示電台卡 -->
    <section id="call-list-panel" class="panel call-list" aria-labelledby="call-list-title">
      <h2 id="call-list-title"><span data-i18n="page.call.title">呼叫清單</span> <span id="call-list-count" class="count"></span>
        <button id="call-list-clear" type="button" class="icon clear-btn" aria-label="清除呼叫清單" title="清除呼叫清單" data-i18n-attr="aria-label:page.call.clear;title:page.call.clear">✕</button></h2>
      <div id="call-list-filters" class="seg list-filters" role="group" aria-label="呼叫清單篩選" data-i18n-attr="aria-label:page.call.filters"></div>
      <div id="call-list-classic" class="table-wrap cards-wrap">
        <table role="table" aria-label="呼叫清單" data-i18n-attr="aria-label:page.call.title">
          <thead role="rowgroup">
            <tr role="row"><th role="columnheader" class="utc">UTC</th><th role="columnheader" class="seq">S.</th><th role="columnheader" class="num snr">dB</th><th role="columnheader" class="num dt">Δt</th><th role="columnheader" class="num hz" data-i18n="page.col.hz">頻率</th><th role="columnheader" class="msg"><span data-i18n="page.col.msg">訊息</span><span class="colhead-n"></span></th><th role="columnheader" class="num dist" data-i18n="page.col.dist">距離</th><th role="columnheader" class="from" data-i18n="page.col.from">發話方</th><th role="columnheader" class="to" data-i18n="page.col.to">接收方</th></tr>
          </thead>
          <tbody id="call-list" role="rowgroup"></tbody>
        </table>
        <p id="call-list-empty" class="hint" data-i18n="page.call.empty">還沒有 CQ、叫我或關注呼號的訊息。</p>
      </div>
    </section>
    <section id="station-panel" class="panel station" aria-labelledby="station-title">
      <h2 id="station-title"><span data-i18n="page.tab.station">電台卡</span> <span id="station-count" class="count"></span></h2>
      <div id="station-view" class="station-view"></div>
      <!-- 通聯進度 Dashboard（使用者 2026-10-07，參考 S20）：黏在電台卡下方，電台卡多時只有上面的清單捲動 -->
      <div id="qso-dash" class="qso-dash" role="status" aria-live="polite" hidden>
        <div class="qso-dash-head"><span id="qso-dash-call" class="qso-dash-call" translate="no"></span> <span id="qso-dash-state"></span></div>
        <ol id="qso-dash-stages" class="qso-dash-stages"></ol>
      </div>
    </section>

    <!-- 控制（平板／桌機右欄的一個分頁；手機的「解碼」「呼叫」分頁各自顯示其中的區塊） -->
    <div id="control-panel" class="control-group">
    <section id="status-panel" class="panel status" aria-live="polite">
      <div class="actions">
        <button id="start" type="button" data-i18n="page.start">開始接收</button>
        <button id="stop" type="button" disabled data-i18n="common.stop">停止</button>
      </div>
      <p id="tap-to-start" class="warn" hidden data-i18n="page.tap_to_start">瀏覽器要先有一次點擊才能啟動音訊：請點一下這個頁面的任何地方開始接收</p>
      <div><span class="label" data-i18n="page.label.state">狀態</span> <span id="state" data-i18n="page.state.idle">尚未開始</span></div>
      <div><span class="label" data-i18n="page.label.clock">時鐘</span> <span id="clock" data-i18n="page.clock.not_measured">尚未量測</span></div>
      <div><span class="label" data-i18n="page.label.report">回報</span> <span id="report" data-i18n="page.report.idle">尚未取得時間校正</span></div>
      <p id="dev-report-note" class="warn" hidden></p>
      <ul id="warnings" class="warnings"></ul>
    </section>
    <!-- JTTY 模式才顯示（使用者 2026-10-09：控制分頁加一個刪除全部 JTTY 訊息） -->
    <section id="jtty-control" class="panel jtty-only" aria-labelledby="jtty-control-title">
      <h2 id="jtty-control-title">JTTY</h2>
      <p class="hint" data-i18n="jtty.clear_all_hint">只刪 JTTY 的對話紀錄，JS8 對話與 SWL Log 不受影響。</p>
      <div class="actions">
        <button id="jtty-clear-all" type="button" class="secondary danger-text" data-i18n="jtty.clear_all">刪除所有 JTTY 訊息</button>
      </div>
      <!-- 收訊診斷（使用者 2026-10-10：訊息中間缺段時找原因；jtty/diag.mjs 收集與規則、jtty/diag-ui.mjs 畫面） -->
      <div id="jtty-diag" class="jtty-diag">
        <h3 data-i18n="jtty.diag.title">收訊診斷</h3>
        <p class="hint" data-i18n="jtty.diag.hint">最近 10 分鐘的 JTTY 收訊紀錄：訊息缺段時找出最可能的原因。只有收訊統計與訊息內容，不含其他個資。</p>
        <h4 data-i18n="jtty.diag.causes">最可能的原因</h4>
        <ul id="jtty-diag-causes" class="jtty-diag-causes" aria-live="polite"></ul>
        <h4 data-i18n="jtty.diag.windows">解碼視窗</h4>
        <p id="jtty-diag-stats" class="jtty-diag-stats"></p>
        <h4 data-i18n="jtty.diag.recent">最近的訊息</h4>
        <ol id="jtty-diag-msgs" class="jtty-diag-msgs"></ol>
        <div class="actions">
          <button id="jtty-diag-copy" type="button" class="secondary" data-i18n="jtty.diag.copy">複製診斷資料</button>
        </div>
      </div>
    </section>
    <section id="qso-panel" class="panel qso" aria-labelledby="qso-title">
      <h2 id="qso-title"><span data-i18n="page.qso.title">通聯</span> <span class="count"><span data-i18n="page.qso.target">目標：</span><strong id="qso-target">—</strong></span></h2>
      <p class="hint" data-i18n="page.qso.hint_call">雙擊（手機長按）解碼清單的一則即可呼叫該台；原本沒在發射時，通聯完成後自動停止。</p>
      <p class="hint" data-i18n="page.qso.hint_bar">自動回應 CQ、通聯順序（1～6）與 CQ 鈕在畫面最下方。</p>
      <div class="actions">
        <button id="qso-call" type="button" class="secondary" data-i18n="page.qso.call_selected">呼叫選取的電台</button>
      </div>
      <p id="qso-status" class="hint" aria-live="polite"></p>
      <!-- 收訊音訊延遲大於自動通聯等待時間（add-dt-offset-advisor D18）：只警告，不改通聯時序 -->
      <p id="qso-delay-warn" class="warn" hidden></p>
    </section>
    <section id="tx-panel" class="panel tx" aria-labelledby="tx-title">
      <h2 id="tx-title" data-i18n="page.tx.title">發射（VOX）</h2>
      <p class="hint" data-i18n="page.tx.hint">音訊從所選輸出送到電台（VOX），網頁不控制 PTT。聲音頻率、輸出裝置、音量在「設置 › 電台與聲音」。試驗期只開放允許清單呼號；連續發射 15 分鐘自動停止。</p>
      <label class="field"><span data-i18n="page.tx.message">訊息</span><input id="tx-text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="37"></label>
      <label class="check"><input id="tx-free" type="checkbox"> <span data-i18n="page.tx.free">自由文字（13 字元內，A-Z 0-9 + - . / ? 與空白）</span></label>
      <label class="field"><span data-i18n="page.tx.parity">時序</span>
        <select id="tx-parity"><option value="auto" data-i18n="page.tx.parity_auto">自動（下一個時序）</option><option value="0" data-i18n="page.tx.parity_even">偶數（0）</option><option value="1" data-i18n="page.tx.parity_odd">奇數（1）</option></select>
      </label>
      <div class="actions">
        <button id="tx-start" type="button" class="danger" data-i18n="page.strip.tx">發射</button>
        <button id="tx-stop" type="button" disabled data-i18n="common.stop">停止</button>
      </div>
      <p id="tx-status" class="hint" aria-live="polite"></p>
    </section>
    </div>
    <section id="log-panel" class="panel log" aria-labelledby="log-title">
      <h2 id="log-title"><span data-i18n="page.tab.log">通聯記錄</span> <span id="qso-count" class="count"></span>
        <button id="qso-filter-clear" type="button" class="secondary" hidden data-i18n="page.log.show_all">顯示全部</button></h2>
      <ul id="qso-list" class="qso-list"></ul>
      <p id="qso-empty" class="hint" data-i18n="page.log.empty">還沒有通聯記錄。完成一次通聯（送出 RR73 或 73）後會出現在這裡。</p>
    </section>
    </div>
  </main>
  <!-- 通聯控制列（使用者 2026-10-06，同 FT8TW 呼叫頁底部）：自動回應 CQ、通聯順序 1～6、CQ -->
  <div id="qso-bar" class="qso-bar" role="group" aria-label="通聯控制" data-i18n-attr="aria-label:page.qsobar.label">
    <label class="qso-auto" title="自動回應 CQ" data-i18n-attr="title:page.qsobar.auto_title"><input id="qso-autofollow" type="checkbox"> <span data-i18n="common.auto">自動</span></label>
    <select id="qso-order" aria-label="通聯順序（本輪送第幾則）" data-i18n-attr="aria-label:page.qsobar.order" disabled></select>
    <button id="qso-cq" type="button" class="cq-btn" title="呼叫 CQ" data-i18n-attr="title:page.qsobar.cq_title">CQ</button>
  </div>
  <!-- 右側浮動按鈕（web-phone-app-layout，同 App FloatView）：只在手機的解碼／呼叫／頻譜頁 -->
  <div id="fab" class="fab" role="toolbar" aria-orientation="vertical" aria-label="快捷按鈕" data-i18n-attr="aria-label:page.fab.label">
    <button id="fab-full" type="button" class="fab-btn" data-icon="fullscreen" aria-pressed="false" aria-label="全螢幕" data-i18n-attr="aria-label:page.fab.fullscreen"></button>
    <button id="fab-mode" type="button" class="fab-btn" data-icon="mode" aria-haspopup="menu" aria-expanded="false" aria-controls="fab-mode-menu" aria-label="模式" data-i18n-attr="aria-label:page.strip.mode"></button>
    <button id="fab-map" type="button" class="fab-btn" data-icon="map" aria-label="地圖" data-i18n-attr="aria-label:page.side.map_name"></button>
    <button id="fab-js8" type="button" class="fab-btn" data-icon="chat" aria-label="JS8 通訊" data-i18n-attr="aria-label:page.fab.js8"></button>
    <div id="fab-mode-menu" class="fab-menu" role="menu" aria-label="模式" data-i18n-attr="aria-label:page.strip.mode" hidden>
      <button type="button" role="menuitemradio" data-mode="FT8">FT8</button>
      <button type="button" role="menuitemradio" data-mode="FT4">FT4</button>
      <button type="button" role="menuitemradio" data-mode="FT2">FT2</button>
      <button type="button" role="menuitemradio" data-mode="JS8">JS8</button>
      <button type="button" role="menuitemradio" data-mode="JTTY">JTTY</button>
    </div>
  </div>
  <nav id="tabbar" class="tabbar" aria-label="分頁" data-i18n-attr="aria-label:page.tabs"></nav>
